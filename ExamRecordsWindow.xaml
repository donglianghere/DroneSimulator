<Window x:Class="DroneSimulator.ExamRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="考试记录查看" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <!-- 按钮样式 -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid样式 -->
        <Style TargetType="DataGrid" x:Key="ModernDataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="考试记录查看" 
                           FontSize="24" FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="记录总数：" Foreground="White" 
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="RecordCountText" Text="0" 
                               Foreground="White" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主要内容区域 -->
        <Border Grid.Row="1" Background="White" Margin="10" 
                BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 筛选和搜索栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="学生姓名：" 
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="StudentNameFilter" Grid.Column="1" 
                             Height="25" Margin="0,0,20,0"
                             TextChanged="FilterTextBox_TextChanged"/>

                    <TextBlock Grid.Column="2" Text="试卷名称：" 
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="ExamNameFilter" Grid.Column="3" 
                             Height="25" Margin="0,0,20,0"
                             TextChanged="FilterTextBox_TextChanged"/>

                    <Button x:Name="RefreshButton" Grid.Column="5" 
                            Content="刷新" Width="80"
                            Style="{StaticResource ModernButton}"
                            Click="RefreshButton_Click"/>
                </Grid>

                <!-- 数据表格 -->
                <DataGrid x:Name="ExamRecordsDataGrid" Grid.Row="1"
                          Style="{StaticResource ModernDataGrid}"
                          SelectionChanged="ExamRecordsDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding ExamSequence}" Width="80"/>
                        <DataGridTextColumn Header="学生姓名" Binding="{Binding StudentName}" Width="120"/>
                        <DataGridTextColumn Header="身份证号" Binding="{Binding StudentId}" Width="150"/>
                        <DataGridTextColumn Header="试卷名称" Binding="{Binding ExamInfo.ExamName}" Width="150"/>
                        <DataGridTextColumn Header="出题教师" Binding="{Binding ExamInfo.TeacherName}" Width="100"/>
                        <DataGridTextColumn Header="得分" Binding="{Binding Score}" Width="60"/>
                        <DataGridTextColumn Header="正确" Binding="{Binding CorrectAnswers}" Width="60"/>
                        <DataGridTextColumn Header="错误" Binding="{Binding WrongAnswers}" Width="60"/>
                        <DataGridTextColumn Header="用时" Binding="{Binding ElapsedTimeString}" Width="80"/>
                        <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="140"/>
                        <DataGridTextColumn Header="提交时间" Binding="{Binding SubmitTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 详细信息区域 -->
                <Expander Grid.Row="2" Header="详细信息" Margin="0,10,0,0" 
                          IsExpanded="False">
                    <Border Background="#F9F9F9" BorderBrush="#DDDDDD" 
                            BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,5,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧：题目状态统计 -->
                            <GroupBox Grid.Column="0" Header="答题情况" Margin="0,0,10,0">
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="QuestionStatusPanel"/>
                                </ScrollViewer>
                            </GroupBox>

                            <!-- 右侧：错误题目列表 -->
                            <GroupBox Grid.Column="1" Header="问题题目">
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="误修复题目：" FontWeight="Bold" Foreground="Red" Margin="0,0,0,5"/>
                                        <ItemsControl x:Name="WronglyRepairedList"/>

                                        <TextBlock Text="未修复题目：" FontWeight="Bold" Foreground="Orange" Margin="0,10,0,5"/>
                                        <ItemsControl x:Name="UnrepairedList"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>
                        </Grid>
                    </Border>
                </Expander>
            </Grid>
        </Border>

        <!-- 底部按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ExportButton" Content="导出Excel" Width="100"
                        Style="{StaticResource ModernButton}"
                        Background="#4CAF50" BorderBrush="#388E3C"
                        Click="ExportButton_Click"/>
                <Button x:Name="DeleteButton" Content="删除记录" Width="100"
                        Style="{StaticResource ModernButton}"
                        Background="#F44336" BorderBrush="#D32F2F"
                        Click="DeleteButton_Click"/>
                <Button x:Name="CloseButton" Content="关闭" Width="80"
                        Style="{StaticResource ModernButton}"
                        Background="#757575" BorderBrush="#616161"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
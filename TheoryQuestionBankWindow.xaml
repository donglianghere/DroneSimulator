<Window x:Class="DroneSimulator.TheoryQuestionBankWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="理论题库管理" Height="800" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">      
            <Separator Margin="5,0"/>
            <!-- 基本操作 -->
            <Button x:Name="AddQuestionButton" Content="新增题目" Width="100" Height="35"
                    Background="#4CAF50" Foreground="White" Margin="0,0,10,0"
                    Click="AddQuestion_Click"/>
            <Button x:Name="EditQuestionButton" Content="编辑题目" Width="100" Height="35"
                    Background="#2196F3" Foreground="White" Margin="0,0,10,0"
                    Click="EditQuestion_Click"/>
            <Button x:Name="DeleteQuestionButton" Content="删除题目" Width="100" Height="35"
                    Background="#F44336" Foreground="White" Margin="0,0,10,0"
                    Click="DeleteQuestion_Click"/>

            <Separator Margin="10,0"/>

            <!-- 导入导出 -->
            <Button x:Name="ImportButton" Content="导入题库" Width="100" Height="35"
                    Background="#FF9800" Foreground="White" Margin="0,0,10,0"
                    Click="Import_Click"/>
            <Button x:Name="ExportButton" Content="导出题库" Width="100" Height="35"
                    Background="#9C27B0" Foreground="White" Margin="0,0,10,0"
                    Click="Export_Click"/>
            <!-- 选择操作 -->
            <CheckBox x:Name="SelectAllCheckBox" Content="全选" Margin="0,0,10,0" 
          VerticalAlignment="Center" Checked="SelectAll_Checked" 
          Unchecked="SelectAll_Unchecked" Indeterminate="SelectAll_Indeterminate"/>
            <TextBlock x:Name="SelectedCountText" Text="已选择: 0 题" VerticalAlignment="Center" 
           Margin="0,0,15,0" Foreground="#666"/>

            <Separator Margin="10,0"/>

            <!-- 搜索和其他 -->
            <TextBox x:Name="SearchTextBox" Width="200" Height="35" 
                     Margin="0,0,10,0" VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="搜索题目..."/>
            <Button x:Name="RefreshButton" Content="刷新" Width="80" Height="35"
                    Background="#607D8B" Foreground="White"
                    Click="Refresh_Click"/>

            <Separator Margin="10,0"/>

            <Button x:Name="CloseButton" Content="关闭" Width="80" Height="35"
                    Background="#F57575" Foreground="White" HorizontalAlignment="Right"
                    Click="Close_Click"/>

            <Separator Margin="10,0"/>

            <Button x:Name="TestButton" Content="测试导入导出" Width="120" Height="35"
                    Background="#9E9E9E" Foreground="White" Margin="0,0,10,0"
                    Click="TestImportExport_Click" ToolTip="生成示例文件并测试导入导出功能"/>
        </StackPanel>

        <!-- 主要内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧筛选面板 -->
            <GroupBox Grid.Column="0" Header="筛选条件" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="题目类型：" FontWeight="Bold" Margin="5"/>
                    <ComboBox x:Name="TypeFilterComboBox" Margin="5" SelectionChanged="Filter_Changed"/>

                    <TextBlock Text="题目分类：" FontWeight="Bold" Margin="5,10,5,5"/>
                    <ComboBox x:Name="CategoryFilterComboBox" Margin="5" SelectionChanged="Filter_Changed"/>

                    <TextBlock Text="难度等级：" FontWeight="Bold" Margin="5,10,5,5"/>
                    <ComboBox x:Name="DifficultyFilterComboBox" Margin="5" SelectionChanged="Filter_Changed"/>

                    <CheckBox x:Name="OnlyActiveCheckBox" Content="仅显示启用题目" 
                              Margin="5,10,5,5" IsChecked="True" 
                              Checked="Filter_Changed" Unchecked="Filter_Changed"/>

                    <Button x:Name="ClearFiltersButton" Content="清除筛选" Width="100" Height="30"
                            Margin="5,20,5,5" Click="ClearFilters_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- 右侧题目列表 -->
            <DataGrid x:Name="QuestionsDataGrid" Grid.Column="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F5F5F5"
                      MouseDoubleClick="QuestionsDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <!-- 复选框列 -->
                    <DataGridTemplateColumn Header="选择" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="QuestionCheckBox_Changed" 
                                          Unchecked="QuestionCheckBox_Changed"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="题目陈述" Binding="{Binding QuestionStatement}" Width="300"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplayName}" Width="80"/>
                    <DataGridTextColumn Header="分类" Binding="{Binding CategoryDisplayName}" Width="100"/>
                    <DataGridTextColumn Header="难度" Binding="{Binding DifficultyDisplayName}" Width="80"/>
                    <DataGridTextColumn Header="分值" Binding="{Binding Points}" Width="60"/>
                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="60"/>
                    <DataGridTextColumn Header="出题人" Binding="{Binding CreatedBy}" Width="100"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 底部状态栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="就绪" VerticalAlignment="Center"/>
            <Separator Margin="10,0"/>
            <TextBlock x:Name="CountTextBlock" Text="总计: 0 题" VerticalAlignment="Center"/>
            <Border Background="Transparent" Width="1" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>
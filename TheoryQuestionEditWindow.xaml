<Window x:Class="DroneSimulator.TheoryQuestionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="理论题目编辑" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <Style TargetType="GroupBox" x:Key="EditGroupBox">
            <Setter Property="Foreground" Value="#23395d"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="TextBox" x:Key="EditTextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="EditComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <!-- 关键修改：将 ScrollViewer 和按钮分离，使用 Grid 布局 -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 可滚动的主内容区域 -->
        <ScrollViewer Grid.Row="0" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      CanContentScroll="False">
            <StackPanel>
                <!-- 基本信息 -->
                <GroupBox Header="基本信息" Style="{StaticResource EditGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="题目ID：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="QuestionIdTextBox" Grid.Row="0" Grid.Column="1" 
                                 Style="{StaticResource EditTextBox}" IsReadOnly="True"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="题目类型：" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="QuestionTypeComboBox" Grid.Row="0" Grid.Column="3" 
                                  Style="{StaticResource EditComboBox}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="分类：" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="CategoryComboBox" Grid.Row="1" Grid.Column="1" 
                                  Style="{StaticResource EditComboBox}"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="难度：" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="DifficultyComboBox" Grid.Row="1" Grid.Column="3" 
                                  Style="{StaticResource EditComboBox}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="分值：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="PointsTextBox" Grid.Row="2" Grid.Column="1" 
                                 Style="{StaticResource EditTextBox}"/>

                        <CheckBox x:Name="IsActiveCheckBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                  Content="启用题目" VerticalAlignment="Center" Margin="5"/>
                    </Grid>
                </GroupBox>

                <!-- 题目内容 -->
                <GroupBox Header="题目内容" Style="{StaticResource EditGroupBox}">
                    <StackPanel>
                        <TextBlock Text="题目陈述：" FontWeight="Bold" Margin="5"/>
                        <TextBox x:Name="QuestionStatementTextBox" 
                                 MinHeight="80" MaxHeight="120"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Disabled"
                                 Style="{StaticResource EditTextBox}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 选项设置 -->
                <GroupBox Header="选项设置" Style="{StaticResource EditGroupBox}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <Button x:Name="AddOptionButton" Content="添加选项" Width="80" Height="30"
                                    Background="#4CAF50" Foreground="White" Click="AddOption_Click"/>
                            <Button x:Name="RemoveOptionButton" Content="删除选项" Width="80" Height="30"
                                    Background="#F44336" Foreground="White" Margin="10,0,0,0"
                                    Click="RemoveOption_Click"/>
                            <TextBlock Text="（最多6个选项）" VerticalAlignment="Center" Margin="10,0,0,0" 
                                       Foreground="Gray"/>
                        </StackPanel>

                        <StackPanel x:Name="OptionsPanel" MaxHeight="300"/>
                    </StackPanel>
                </GroupBox>

                <!-- 题目解析 -->
                <GroupBox Header="题目解析" Style="{StaticResource EditGroupBox}">
                    <TextBox x:Name="ExplanationTextBox" 
                             MinHeight="60" MaxHeight="100"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Disabled"
                             Style="{StaticResource EditTextBox}"/>
                </GroupBox>

                <!-- 出题信息 -->
                <GroupBox Header="出题信息" Style="{StaticResource EditGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="出题人：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="CreatedByTextBox" Grid.Column="1" 
                                 Style="{StaticResource EditTextBox}"/>

                        <TextBlock Grid.Column="2" Text="创建时间：" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock x:Name="CreatedTimeTextBlock" Grid.Column="3" 
                                   VerticalAlignment="Center" Margin="5"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 固定在底部的按钮栏 - 不受滚动条影响 -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0,1,0,0" 
                Padding="0,10,0,0"
                Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ValidateButton" Content="验证题目" Width="80" Height="35"
                        Background="#FF9800" Foreground="White" Margin="0,0,10,0"
                        Click="Validate_Click"/>
                <Button x:Name="SaveButton" Content="保存" Width="80" Height="35"
                        Background="#2196F3" Foreground="White" Margin="0,0,10,0"
                        Click="Save_Click"/>
                <Button x:Name="CancelButton" Content="取消" Width="80" Height="35"
                        Background="#757575" Foreground="White"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
<Window x:Class="DroneSimulator.AdminDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="串口参数设置" Height="302" Width="315"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#181F2A"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- 下拉项样式：高亮蓝字，深色底 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#223B5A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A4A6A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 按钮样式：深色底+蓝色高光 -->
        <Style x:Key="TechButton" TargetType="Button">
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#5EC6FF" BlurRadius="8" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A4A6A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource TechButton}">
            <Setter Property="Background" Value="#B22222"/>
            <Setter Property="BorderBrush" Value="#B22222"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#B22222" BlurRadius="8" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A1A1A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ComboBox样式：深色底+蓝色高光 -->
        <Style x:Key="TechComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"/>
                            <ToggleButton Grid.Column="2"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalAlignment="Right"
                                          Width="20"
                                          Height="20">
                                <Path Data="M 0 0 L 8 0 L 4 5 Z"
                                      Fill="#5EC6FF"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0,6,0,0"/>
                            </ToggleButton>
                            <ContentPresenter Margin="6,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#232F3E"
                                        BorderBrush="#5EC6FF"
                                        BorderThickness="2"
                                        CornerRadius="8">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 标签样式：高亮蓝 -->
        <Style x:Key="TechLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10,10,0,0" Height="244" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="45"/>
            <RowDefinition Height="Auto" MinHeight="45"/>
            <RowDefinition Height="Auto" MinHeight="45"/>
            <RowDefinition Height="Auto" MinHeight="45"/>
            <RowDefinition Height="Auto" MinHeight="45"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Center" Width="206">
            <TextBlock Text="串口号：" Width="100" VerticalAlignment="Center" Style="{StaticResource TechLabel}"/>
            <ComboBox x:Name="PortComboBox" Width="100" Style="{StaticResource TechComboBox}" HorizontalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,15" HorizontalAlignment="Center" Width="206">
            <TextBlock Text="波特率：" Width="100" VerticalAlignment="Center" Style="{StaticResource TechLabel}"/>
            <ComboBox x:Name="BaudRateComboBox" Width="100" Style="{StaticResource TechComboBox}" HorizontalContentAlignment="Center">
                <ComboBoxItem Content="9600"  IsSelected="True"/>
                <ComboBoxItem Content="19200"/>
                <ComboBoxItem Content="38400"/>
                <ComboBoxItem Content="57600"/>
                <ComboBoxItem Content="115200"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,15" HorizontalAlignment="Center" Width="206">
            <TextBlock Text="奇偶校验：" Width="100" VerticalAlignment="Center" Style="{StaticResource TechLabel}"/>
            <ComboBox x:Name="ParityComboBox" Width="100" Style="{StaticResource TechComboBox}" HorizontalContentAlignment="Center">
                <ComboBoxItem Content="无" IsSelected="True"/>
                <ComboBoxItem Content="有"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,15" HorizontalAlignment="Center" Width="206">
            <TextBlock Text="停止位：" Width="100" VerticalAlignment="Center" Style="{StaticResource TechLabel}"/>
            <ComboBox x:Name="StopBitsComboBox" Width="100" Style="{StaticResource TechComboBox}" HorizontalContentAlignment="Center">
                <ComboBoxItem Content="0"/>
                <ComboBoxItem Content="1"  IsSelected="True"/>
                <ComboBoxItem Content="2"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Left" Margin="35,10,0,60" Width="240" >
            <Button Content="打开" Width="65" Height="36" Style="{StaticResource TechButton}" Click="OpenPort_Click"/>
            <Button Content="保存" Width="65" Height="36" Style="{StaticResource TechButton}" Click="SaveConfig_Click"/>
            <Button Content="退出" Width="65" Height="36" Style="{StaticResource ExitButtonStyle}" Click="Exit_Click"/>
        </StackPanel>
    </Grid>
</Window>
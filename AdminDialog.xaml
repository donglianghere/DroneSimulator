<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="DroneSimulator.AdminDialog"
        xmlns:local="clr-namespace:DroneSimulator"    
        Title="系统管理" Height="458" Width="690"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#181F2A"
        FontFamily="Segoe UI">
    <Window.Resources>
        <local:UserTypeToStringConverter x:Key="UserTypeToStringConverter"/>
        <!-- 下拉项样式：高亮蓝字，深色底 -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#223B5A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A4A6A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 按钮样式：深色底+蓝色高光 -->
        <Style x:Key="TechButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#5EC6FF" BlurRadius="8" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A4A6A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFD700"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFD700" BlurRadius="12" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExitButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TechButton}">
            <Setter Property="Background" Value="#B22222"/>
            <Setter Property="BorderBrush" Value="#B22222"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#B22222" BlurRadius="8" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A1A1A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ComboBox样式：深色底+蓝色高光 -->
        <Style x:Key="TechComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <!-- 标签样式：高亮蓝 -->
        <Style x:Key="TechLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10,10,10,10" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：串口配置 -->
        <Border Grid.Column="0" Background="#232F3E" CornerRadius="12" Padding="20" HorizontalAlignment="Center" Width="370">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Text="端  口  配  置" FontSize="18" Style="{StaticResource TechLabel}" 
                           HorizontalAlignment="Center" Margin="0,-4,0,20"/>

                <!-- 配置选项框 -->
                <Border Background="#1A1A1A" BorderBrush="#5EC6FF" BorderThickness="2" 
                        Padding="15" Margin="0,25,0,25" Grid.RowSpan="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- 串口号选择 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Center">
                                <TextBlock Text="串口号：" Width="80" VerticalAlignment="Center" Style="{StaticResource TechLabel}"/>
                                <ComboBox x:Name="PortComboBox" TabIndex="0" Width="180" Style="{StaticResource TechComboBox}" 
                                          SelectionChanged="PortComboBox_SelectionChanged"/>
                            </StackPanel>

                            <!-- 串口用途选择 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Center">
                                <TextBlock Text="用途：" Width="80" VerticalAlignment="Center" Style="{StaticResource TechLabel}"/>
                                <ComboBox x:Name="PurposeComboBox" TabIndex="1" Width="180" Style="{StaticResource TechComboBox}" 
                                          SelectionChanged="PurposeComboBox_SelectionChanged"/>
                            </StackPanel>

                            <!-- 波特率 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Center">
                                <TextBlock Text="波特率：" Width="80" VerticalAlignment="Center" Style="{StaticResource TechLabel}"/>
                                <ComboBox x:Name="BaudRateComboBox" TabIndex="2" Width="180" Style="{StaticResource TechComboBox}">
                                    <ComboBoxItem Content="9600"/>
                                    <ComboBoxItem Content="19200"/>
                                    <ComboBoxItem Content="38400"/>
                                    <ComboBoxItem Content="57600"/>
                                    <ComboBoxItem Content="115200" IsSelected="True"/>
                                    <ComboBoxItem Content="230400"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 奇偶校验 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Center">
                                <TextBlock Text="奇偶校验：" Width="80" VerticalAlignment="Center" Style="{StaticResource TechLabel}"/>
                                <ComboBox x:Name="ParityComboBox" TabIndex="3" Width="180" Style="{StaticResource TechComboBox}">
                                    <ComboBoxItem Content="无" IsSelected="True"/>
                                    <ComboBoxItem Content="偶校验"/>
                                    <ComboBoxItem Content="奇校验"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 停止位 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Center">
                                <TextBlock Text="停止位：" Width="80" VerticalAlignment="Center" Style="{StaticResource TechLabel}"/>
                                <ComboBox x:Name="StopBitsComboBox" TabIndex="4" Width="180" Style="{StaticResource TechComboBox}">
                                    <ComboBoxItem Content="1" IsSelected="True"/>
                                    <ComboBoxItem Content="1.5"/>
                                    <ComboBoxItem Content="2"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 状态显示 -->
                            <Border Background="DarkBlue" CornerRadius="2" Padding="10" Margin="0,2,0,0" Width="259">
                                <TextBlock x:Name="PortStatusText" Text="状态：未选择端口" 
                                           Style="{StaticResource TechLabel}" FontSize="12" 
                                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="测 试 连 接" TabIndex="5" Width="95" Height="36" Style="{StaticResource TechButton}" 
                            Click="OpenPort_Click"/>
                    <Button Content="保 存 配 置" TabIndex="6" Width="95" Height="36" Style="{StaticResource TechButton}" 
                            Click="SaveConfig_Click"/>
                    <Button Content="端 口 管 理" TabIndex="7" Width="95" Height="36" Style="{StaticResource TechButton}" 
                            Click="ManageAllPorts_Click"/>                    
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧：账户管理 -->
        <Border Grid.Column="1" Background="#232F3E" CornerRadius="12" Padding="20" HorizontalAlignment="Center" Width="370">
            <Grid Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="账  户  管  理" FontSize="18" Style="{StaticResource TechLabel}" 
                           HorizontalAlignment="Center" Margin="0,-4,0,20"/>
                <!-- 账户列表 -->
                <ListView x:Name="AccountListView" Margin="0,25,0,25" Background="#232F3E" BorderBrush="#5EC6FF" BorderThickness="2" 
                          Foreground="#5EC6FF" FontSize="18" SelectionMode="Single" av:ItemsSource="{av:SampleData ItemCount=5}"  HorizontalAlignment="Left" Width="320" Grid.RowSpan="2">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="用户类型" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource UserTypeToStringConverter}}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="姓名" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" 
                                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="身份证号" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IdNumber}" 
                                                    HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" >
                    <Button x:Name="DeleteAccountButton" TabIndex="9" Content="删 除 账 户" Width="95" Height="36" Style="{StaticResource TechButton}" Click="DeleteAccount_Click"/>
                    <Button x:Name="EditAccountButton" TabIndex="10" Content="编 辑 账 户" Width="95" Height="36" Style="{StaticResource TechButton}" Click="EditAccount_Click"/>
                    <Button x:Name="AddAccountButton" TabIndex="11" Content="添 加 账 户" Width="95" Height="36" Style="{StaticResource TechButton}" Click="AddAccount_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
<Window x:Class="DroneSimulator.QuestionPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DroneSimulator"
        Title="出题窗口" Height="1280" Width="1620"
        WindowStyle="SingleBorderWindow" WindowState="Maximized" ShowInTaskbar="True"
        Background="#FFFFFF">
    <Window.Resources>
        <!-- 保持所有现有的样式定义不变 -->
        <!-- GroupBox 样式 -->
        <Style TargetType="GroupBox" x:Key="ClosedGroupBox">
            <Setter Property="Foreground" Value="#23395d"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border BorderBrush="#23395d" BorderThickness="2" CornerRadius="6" Background="#F8F9FA">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}"
                                           Foreground="#23395d"
                                           FontWeight="Bold"
                                           FontSize="18"
                                           Margin="12,8,0,8"/>
                                <ContentPresenter Margin="12,0,12,12"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox" x:Key="SeriousGroupBox">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="#2D3A4A" BorderThickness="2" CornerRadius="6" Background="#F8F9FA">
                                <DockPanel Margin="0,18,0,0">
                                    <ContentPresenter Margin="12,6,12,12"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="#2D3A4A"
                                       Background="#F8F9FA"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="16,0,0,0"
                                       Padding="4,0"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button 样式 -->
        <Style TargetType="Button" x:Key="SeriousButton">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D3A4A"/>
            <Setter Property="BorderBrush" Value="#1A2230"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="10,8,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox 样式 -->
        <Style TargetType="TextBox" x:Key="SeriousTextBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#2D3A4A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- 保持所有其他现有的样式定义... -->
        <!-- 电机 -->
        <Style TargetType="GroupBox" x:Key="MotorGroupBox">
            <Setter Property="Foreground" Value="#23395d"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="#23395d" BorderThickness="2" CornerRadius="6" Background="#F8F9FA">
                                <DockPanel Margin="0,18,0,0">
                                    <ContentPresenter Margin="12,6,12,12"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="#23395d"
                                       Background="#F8F9FA"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="16,0,0,0"
                                       Padding="4,0"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 电调 -->
        <Style TargetType="GroupBox" x:Key="EscGroupBox" BasedOn="{StaticResource MotorGroupBox}">
            <Setter Property="Foreground" Value="#7B341E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="#7B341E" BorderThickness="2" CornerRadius="6" Background="#F8F9FA">
                                <DockPanel Margin="0,18,0,0">
                                    <ContentPresenter Margin="12,6,12,12"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="#7B341E"
                                       Background="#F8F9FA"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="16,0,0,0"
                                       Padding="4,0"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PWM -->
        <Style TargetType="GroupBox" x:Key="PwmGroupBox" BasedOn="{StaticResource MotorGroupBox}">
            <Setter Property="Foreground" Value="#226644"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="#226644" BorderThickness="2" CornerRadius="6" Background="#F8F9FA">
                                <DockPanel Margin="0,18,0,0">
                                    <ContentPresenter Margin="12,6,12,12"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="#226644"
                                       Background="#F8F9FA"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="16,0,0,0"
                                       Padding="4,0"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GPS -->
        <Style TargetType="GroupBox" x:Key="GpsGroupBox" BasedOn="{StaticResource MotorGroupBox}">
            <Setter Property="Foreground" Value="#1B4965"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="#1B4965" BorderThickness="2" CornerRadius="6" Background="#F8F9FA">
                                <DockPanel Margin="0,18,0,0">
                                    <ContentPresenter Margin="12,6,12,12"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="#1B4965"
                                       Background="#F8F9FA"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="16,0,0,0"
                                       Padding="4,0"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 接收机 -->
        <Style TargetType="GroupBox" x:Key="ReceiverGroupBox" BasedOn="{StaticResource MotorGroupBox}">
            <Setter Property="Foreground" Value="#7C4700"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="#7C4700" BorderThickness="2" CornerRadius="6" Background="#F8F9FA">
                                <DockPanel Margin="0,18,0,0">
                                    <ContentPresenter Margin="12,6,12,12"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="#7C4700"
                                       Background="#F8F9FA"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="16,0,0,0"
                                       Padding="4,0"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 舵机 -->
        <Style TargetType="GroupBox" x:Key="ServoGroupBox" BasedOn="{StaticResource MotorGroupBox}">
            <Setter Property="Foreground" Value="#4B3869"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="#4B3869" BorderThickness="2" CornerRadius="6" Background="#F8F9FA">
                                <DockPanel Margin="0,18,0,0">
                                    <ContentPresenter Margin="12,6,12,12"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="#4B3869"
                                       Background="#F8F9FA"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="16,0,0,0"
                                       Padding="4,0"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 电池 -->
        <Style TargetType="GroupBox" x:Key="BatteryGroupBox" BasedOn="{StaticResource MotorGroupBox}">
            <Setter Property="Foreground" Value="#B22222"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="#B22222" BorderThickness="2" CornerRadius="6" Background="#F8F9FA">
                                <DockPanel Margin="0,18,0,0">
                                    <ContentPresenter Margin="12,6,12,12"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="#B22222"
                                       Background="#F8F9FA"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="16,0,0,0"
                                       Padding="4,0"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧 TabControl - 包含题库面板 -->
        <TabControl Grid.Column="0" Margin="10" Background="#E8E8E8" 
                    BorderBrush="#23395d" BorderThickness="2"
                    SelectionChanged="TabControl_SelectionChanged">
            <!-- 新增：理论题库选项卡 - 放在最前面 -->
            <TabItem Header="理论题库" Background="#D4C6E8">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="理论题库" FontSize="16" FontWeight="Bold" 
                       Foreground="#23395d" Padding="10,5"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>

                <Grid Background="#D4C6E8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="142*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 顶部控制按钮组 -->
                    <StackPanel Orientation="Horizontal" 
                    Margin="0,10,0,0" HorizontalAlignment="Right" 
                    VerticalAlignment="Top" Grid.Column="1">
                        <RadioButton x:Name="TheorySelectAllRadio" Content="全选  " Margin="0,0,10,0" 
                         GroupName="TheorySelectGroup" FontSize="18" VerticalAlignment="Center" 
                         Checked="TheorySelectAllRadio_Checked"/>
                        <RadioButton x:Name="TheoryClearAllRadio" Content="清空  " Margin="0,0,10,0"
                         GroupName="TheorySelectGroup" FontSize="18" VerticalAlignment="Center" 
                         Checked="TheoryClearAllRadio_Checked"/>
                        <RadioButton x:Name="TheoryRandomRadio" Content="随机  " Margin="0,0,10,0"
                         GroupName="TheorySelectGroup" FontSize="18" VerticalAlignment="Center" 
                         Checked="TheoryRandomRadio_Checked"/>

                        <ComboBox x:Name="TheoryRandomCountComboBox" Width="60" Height="25" 
                                  FontSize="16" VerticalAlignment="Center"
                                  ToolTip="选择随机生成的理论题目数量"
                                  IsEditable="True"
                                  Text="5"
                                  SelectionChanged="TheoryRandomCountComboBox_SelectionChanged">
                            <ComboBoxItem Content="10" IsSelected="True"/>
                            <ComboBoxItem Content="15"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="40"/>
                            <ComboBoxItem Content="60"/>
                            <ComboBoxItem Content="80"/>
                            <ComboBoxItem Content="100"/>
                            <ComboBoxItem Content="120"/>
                            <ComboBoxItem Content="200"/>
                        </ComboBox>

                        <TextBlock Text="题" FontSize="18" VerticalAlignment="Center" 
                                   Margin="10,0,10,0" />

                        <!-- 添加题库管理按钮 -->
                        <Button x:Name="ManageTheoryBankButton" Content="题 库 管 理" Width="120" Height="40"
                                  Background="#4CAF50" Foreground="White" FontSize="18"
                                  Click="ManageTheoryBank_Click" Margin="10,0,20,0"/>
                    </StackPanel>

                    <!-- 理论题库内容区域 - 动态显示题目 -->
                    <ScrollViewer Margin="0,50,0,0" VerticalScrollBarVisibility="Auto" Background="Transparent" Grid.ColumnSpan="2">
                        <StackPanel x:Name="TheoryQuestionsPanel" Margin="20">
                            <!-- 动态生成的题目将显示在这里 -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 电路实测选择选项卡 -->
            <TabItem Header="电路实测" Background="#B3AAC6">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="电路实测" FontSize="16" FontWeight="Bold" 
                                   Foreground="#23395d" Padding="10,5"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>

                <Grid Background="#B3AAC6">
                    <!-- 题库面板内容 -->
                    <Grid>
                        <!-- 右侧RadioButton组 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" 
                                    Margin="10,10,0,0" HorizontalAlignment="Right" 
                                    VerticalAlignment="Top">
                            <RadioButton x:Name="CircuitSelectAllRadio" Content="全选  " Margin="0,0,10,0" 
                                         GroupName="SelectGroup" Checked="CircuitSelectAllRadio_Checked" FontSize="16"/>
                            <RadioButton x:Name="CircuitClearAllRadio" Content="清空       "
                                         GroupName="SelectGroup" Checked="CircuitClearAllRadio_Checked" FontSize="16"/>
                            <!-- 新增：随机选择功能 -->
                            <RadioButton x:Name="CircuitRandomRadio" Content="随机  " Margin="0,0,10,0"
                                        GroupName="SelectGroup" Checked="CircuitRandomRadio_Checked" FontSize="16"/>

                            <!-- 新增：随机题目数量下拉列表 -->
                            <ComboBox x:Name="CircuitRandomCountComboBox" Width="60" Height="25" 
                                      FontSize="16" VerticalAlignment="Center"
                                      ToolTip="选择随机生成的题目数量"
                                      IsEditable="True"
                                      Text="4"
                                      SelectionChanged="CircuitRandomCountComboBox_SelectionChanged">
                                <!-- 1到50的选项 -->
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6" IsSelected="True"/>
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="11"/>
                                <ComboBoxItem Content="12"/>
                                <ComboBoxItem Content="13"/>
                                <ComboBoxItem Content="14"/>
                                <ComboBoxItem Content="15"/>
                                <ComboBoxItem Content="16"/>
                                <ComboBoxItem Content="17"/>
                                <ComboBoxItem Content="18"/>
                                <ComboBoxItem Content="19"/>
                                <ComboBoxItem Content="20"/>
                                <ComboBoxItem Content="21"/>
                                <ComboBoxItem Content="22"/>
                                <ComboBoxItem Content="23"/>
                                <ComboBoxItem Content="24"/>
                                <ComboBoxItem Content="25"/>
                                <ComboBoxItem Content="26"/>
                                <ComboBoxItem Content="27"/>
                                <ComboBoxItem Content="28"/>
                                <ComboBoxItem Content="29"/>
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="31"/>
                                <ComboBoxItem Content="32"/>
                                <ComboBoxItem Content="33"/>
                                <ComboBoxItem Content="34"/>
                                <ComboBoxItem Content="35"/>
                                <ComboBoxItem Content="36"/>
                                <ComboBoxItem Content="37"/>
                                <ComboBoxItem Content="38"/>
                                <ComboBoxItem Content="39"/>
                                <ComboBoxItem Content="40"/>
                                <ComboBoxItem Content="41"/>
                                <ComboBoxItem Content="42"/>
                                <ComboBoxItem Content="43"/>
                                <ComboBoxItem Content="44"/>
                                <ComboBoxItem Content="45"/>
                                <ComboBoxItem Content="46"/>
                                <ComboBoxItem Content="47"/>
                                <ComboBoxItem Content="48"/>
                                <ComboBoxItem Content="49"/>
                                <ComboBoxItem Content="50"/>
                            </ComboBox>

                            <TextBlock Text="题" FontSize="16" VerticalAlignment="Top" 
                                       Margin="10,0,25,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 可滚动内容，顶部留出空间避免被标题遮挡 -->
                    <ScrollViewer Margin="0,40,0,0" VerticalScrollBarVisibility="Auto" Background="Transparent">
                        <StackPanel>
                            <!-- 电机部分 -->
                            <GroupBox Header="电机" Margin="0,0,0,10" Style="{StaticResource ClosedGroupBox}" Height="426">
                                <UniformGrid Columns="2">
                                    <GroupBox Header="M1" Margin="5" Style="{StaticResource MotorGroupBox}">
                                        <StackPanel>
                                            <CheckBox x:Name="M1_1" Content="电机M1-A线路通断" Margin="5" FontWeight="Normal" 
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00010100EEEE"/>
                                            <CheckBox x:Name="M1_2" Content="电机M1-B线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00020100EEEE"/>
                                            <CheckBox x:Name="M1_3" Content="电机M1-C线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00030100EEEE"/>
                                            <CheckBox x:Name="M1_4" Content="电机M1-CG线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00040100EEEE"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="M2" Margin="5" Style="{StaticResource MotorGroupBox}">
                                        <StackPanel>
                                            <CheckBox x:Name="M2_1" Content="电机M2-A线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00050100EEEE"/>
                                            <CheckBox x:Name="M2_2" Content="电机M2-B线路通断" Margin="5" FontWeight="Normal" 
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00060100EEEE"/>
                                            <CheckBox x:Name="M2_3" Content="电机M2-C线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00070100EEEE"/>
                                            <CheckBox x:Name="M2_4" Content="电机M2-CG线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00080100EEEE"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="M3" Margin="5" Style="{StaticResource MotorGroupBox}">
                                        <StackPanel>
                                            <CheckBox x:Name="M3_1" Content="电机M3-A线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00090100EEEE"/>
                                            <CheckBox x:Name="M3_2" Content="电机M3-B线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00100100EEEE"/>
                                            <CheckBox x:Name="M3_3" Content="电机M3-C线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00110100EEEE"/>
                                            <CheckBox x:Name="M3_4" Content="电机M3-CG线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00120100EEEE"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="M4" Margin="5" Style="{StaticResource MotorGroupBox}">
                                        <StackPanel>
                                            <CheckBox x:Name="M4_1" Content="电机M4-A线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00130100EEEE"/>
                                            <CheckBox x:Name="M4_2" Content="电机M4-B线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00140100EEEE"/>
                                            <CheckBox x:Name="M4_3" Content="电机M4-C线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00150100EEEE"/>
                                            <CheckBox x:Name="M4_4" Content="电机M4-CG线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00160100EEEE"/>
                                        </StackPanel>
                                    </GroupBox>
                                </UniformGrid>
                            </GroupBox>

                            <!-- 电调部分 -->
                            <GroupBox Header="电调" Margin="0,0,0,10" Style="{StaticResource ClosedGroupBox}">
                                <UniformGrid Columns="2">
                                    <GroupBox Header="ESC1" Margin="5" Style="{StaticResource SeriousGroupBox}">
                                        <StackPanel>
                                            <CheckBox x:Name="ESC1_1" Content="电调1+供电线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00170100EEEE"/>
                                            <CheckBox x:Name="ESC1_2" Content="电调S1信号线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00180100EEEE"/>
                                            <CheckBox x:Name="ESC1_3" Content="电调1-供电线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00190100EEEE"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="ESC2" Margin="5" Style="{StaticResource SeriousGroupBox}">
                                        <StackPanel>
                                            <CheckBox x:Name="ESC2_1" Content="电调2+供电线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00210100EEEE"/>
                                            <CheckBox x:Name="ESC2_2" Content="电调S2信号线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00220100EEEE"/>
                                            <CheckBox x:Name="ESC2_3" Content="电调2-供电线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00230100EEEE"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="ESC3" Margin="5" Style="{StaticResource SeriousGroupBox}">
                                        <StackPanel>
                                            <CheckBox x:Name="ESC3_1" Content="电调3+供电线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00250100EEEE"/>
                                            <CheckBox x:Name="ESC3_2" Content="电调S3信号线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00260100EEEE"/>
                                            <CheckBox x:Name="ESC3_3" Content="电调3-供电线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00270100EEEE"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="ESC4" Margin="5" Style="{StaticResource SeriousGroupBox}">
                                        <StackPanel>
                                            <CheckBox x:Name="ESC4_1" Content="电调4+供电线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00290100EEEE"/>
                                            <CheckBox x:Name="ESC4_2" Content="电调S4信号线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00300100EEEE"/>
                                            <CheckBox x:Name="ESC4_3" Content="电调4-供电线路通断" Margin="5" FontWeight="Normal"
                                                        local:CheckBoxCommandHelper.CommandString="FFFF00310100EEEE"/>
                                        </StackPanel>
                                    </GroupBox>
                                </UniformGrid>
                            </GroupBox>

                            <!-- PWM输出部分 -->
                            <GroupBox Header="PWM输出" Margin="0,0,0,10" Style="{StaticResource ClosedGroupBox}">
                                <UniformGrid Columns="2">
                                    <GroupBox Header="S5" Margin="5" Style="{StaticResource PwmGroupBox}">

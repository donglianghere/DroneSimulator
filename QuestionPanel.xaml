                                                <TextBlock Grid.Row="13" Grid.Column="0" Text="  ▪ 传感器校准：" FontWeight="Normal" FontSize="11" Margin="5,0,0,0"/>
                                                <TextBlock Grid.Row="13" Grid.Column="1" x:Name="FCSensorCalibrationCountText" Text="-- 题" FontSize="11"/>

                                                <TextBlock Grid.Row="14" Grid.Column="0" Text="  ▪ 飞行模式：" FontWeight="Normal" FontSize="11" Margin="5,0,0,0"/>
                                                <TextBlock Grid.Row="14" Grid.Column="1" x:Name="FCFlightModesCountText" Text="-- 题" FontSize="11"/>

                                                <TextBlock Grid.Row="15" Grid.Column="0" Text="  ▪ 安全设置：" FontWeight="Normal" FontSize="11" Margin="5,0,0,0"/>
                                                <TextBlock Grid.Row="15" Grid.Column="1" x:Name="FCSafetySettingsCountText" Text="-- 题" FontSize="11"/>

                                                <TextBlock Grid.Row="16" Grid.Column="0" Text="  ▪ 高级功能：" FontWeight="Normal" FontSize="11" Margin="5,0,0,0"/>
                                                <TextBlock Grid.Row="16" Grid.Column="1" x:Name="FCAdvancedFeaturesCountText" Text="-- 题" FontSize="11"/>

                                                <!-- 难度分析 -->
                                                <TextBlock Grid.Row="17" Grid.Column="0" Grid.ColumnSpan="2" Text="🎯 难度分布" FontWeight="Bold" FontSize="12" Margin="0,8,0,3" Foreground="#D32F2F"/>

                                                <TextBlock Grid.Row="18" Grid.Column="0" Text="  ▪ 简单：" FontWeight="Normal" FontSize="11" Margin="5,0,0,0"/>
                                                <TextBlock Grid.Row="18" Grid.Column="1" x:Name="FCEasyCountText" Text="-- 题" FontSize="11"/>

                                                <TextBlock Grid.Row="19" Grid.Column="0" Text="  ▪ 中等：" FontWeight="Normal" FontSize="11" Margin="5,0,0,0"/>
                                                <TextBlock Grid.Row="19" Grid.Column="1" x:Name="FCMediumCountText" Text="-- 题" FontSize="11"/>

                                                <TextBlock Grid.Row="20" Grid.Column="0" Text="  ▪ 困难：" FontWeight="Normal" FontSize="11" Margin="5,0,0,0"/>
                                                <TextBlock Grid.Row="20" Grid.Column="1" x:Name="FCHardCountText" Text="-- 题" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </GroupBox>
                            </Grid>

                            <!-- 🚀 修改：当前出题分析 - 左中右三块布局 -->
                            <TextBlock Text="当前出题分析" FontSize="20" FontWeight="Bold" 
                          HorizontalAlignment="Center" Margin="0,10,0,10"/>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左块：理论试题选择分析 -->
                                <GroupBox Grid.Column="0" Header="理论试题选择分析" Style="{StaticResource ClosedGroupBox}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="📊 已选择题目：" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TheorySelectedCountText" Text="-- 题" FontSize="13" Foreground="#4CAF50"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="📝 单选题选择：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TheorySelectedSingleText" Text="-- 题" FontSize="12"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="📋 多选题选择：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TheorySelectedMultipleText" Text="-- 题" FontSize="12"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="🎯 难度分布：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TheoryDifficultyDistributionText" Text="--" FontSize="11" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="💯 总分值：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TheoryTotalPointsText" Text="-- 分" FontSize="12"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="📈 选择率：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TheorySelectionRateText" Text="-- %" FontSize="12"/>

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="🎲 最近操作：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TheoryLastOperationText" Text="--" FontSize="11" Foreground="#666" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <!-- 中块：电路实测试题选择分析 -->
                                <GroupBox Grid.Column="2" Header="电路实测试题选择分析" Style="{StaticResource ClosedGroupBox}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="📊 已选择题目：" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CircuitSelectedCountText" Text="-- 题" FontSize="13" Foreground="#4CAF50"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="🔧 电机选择：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CircuitSelectedMotorText" Text="-- 题" FontSize="12"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="⚡ 电调选择：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CircuitSelectedEscText" Text="-- 题" FontSize="12"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="📡 PWM选择：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CircuitSelectedPwmText" Text="-- 题" FontSize="12"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="📍 其他选择：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CircuitSelectedOtherText" Text="-- 题" FontSize="12"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="📈 选择率：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="CircuitSelectionRateText" Text="-- %" FontSize="12"/>

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="🎲 最近操作：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="CircuitLastOperationText" Text="--" FontSize="11" Foreground="#666" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <!-- 右块：飞控实操试题选择分析 -->
                                <GroupBox Grid.Column="4" Header="飞控实操试题选择分析" Style="{StaticResource ClosedGroupBox}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="📊 已选择题目：" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FCSelectedCountText" Text="-- 题" FontSize="13" Foreground="#4CAF50"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="⚙️ 参数类型：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FCSelectedParameterText" Text="-- 题" FontSize="12"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="🎯 难度分布：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FCDifficultyDistributionText" Text="--" FontSize="11" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="🔢 数据类型：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FCDataTypeDistributionText" Text="--" FontSize="11" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="💯 总分值：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="FCTotalPointsText" Text="-- 分" FontSize="12"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="📈 选择率：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="FCSelectionRateText" Text="-- %" FontSize="12"/>

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="🎲 最近操作：" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="FCLastOperationText" Text="--" FontSize="11" Foreground="#666" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>

                            <!-- 保留原有的考试记录分析 -->
                            <TextBlock Text="考试记录分析" FontSize="20" FontWeight="Bold" 
                          HorizontalAlignment="Center" Margin="0,10,0,10"/>

                            <!-- 保留原有的考试记录统计内容 -->
                            <GroupBox Header="考试记录统计" Style="{StaticResource ClosedGroupBox}" Margin="0,10,0,0">
                                <StackPanel>
                                    <!-- 刷新按钮和操作按钮 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button x:Name="RefreshRecordsStatsButton" Content="🔄 刷新统计" 
                                Click="RefreshRecordsStats_Click" 
                                Background="#4CAF50" Foreground="White"
                                Padding="8,4" FontSize="12" Margin="0,0,10,0"/>
                                        <Button x:Name="ViewDetailedRecordsButton" Content="📊 查看详细记录" 
                                Click="ViewDetailedRecords_Click" 
                                Background="#2196F3" Foreground="White"
                                Padding="8,4" FontSize="12" Margin="0,0,10,0"/>
                                        <Button x:Name="ExportRecordsStatsButton" Content="📁 导出统计" 
                                Click="ExportRecordsStats_Click" 
                                Background="#FF9800" Foreground="White"
                                Padding="8,4" FontSize="12"/>
                                    </StackPanel>

                                    <!-- 统计信息显示区域 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 左列：基础统计 -->
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="📋 基础统计" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="TotalRecordsText" Text="总考试记录：-- 份" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="TotalStudentsText" Text="参考学生人数：-- 人" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="LatestExamDateText" Text="最新考试时间：--" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="OldestExamDateText" Text="最早考试时间：--" FontSize="12" Margin="0,2"/>

                                            <TextBlock Text="📊 分数统计" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>
                                            <TextBlock x:Name="AverageScoreText" Text="平均分：-- 分" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="HighestScoreText" Text="最高分：-- 分" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="LowestScoreText" Text="最低分：-- 分" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="PassRateText" Text="及格率：-- %" FontSize="12" Margin="0,2"/>
                                        </StackPanel>

                                        <!-- 右列：试卷和教师统计 -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="📝 试卷统计" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="TotalExamsText" Text="使用的试卷数：-- 份" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="MostUsedExamText" Text="使用最多的试卷：--" FontSize="12" Margin="0,2" TextWrapping="Wrap"/>

                                            <TextBlock Text="👨‍🏫 教师统计" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>
                                            <TextBlock x:Name="TotalTeachersText" Text="出题教师数：-- 人" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="MostActiveTeacherText" Text="最活跃教师：--" FontSize="12" Margin="0,2" TextWrapping="Wrap"/>

                                            <TextBlock Text="⏱️ 时间统计" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>
                                            <TextBlock x:Name="AverageTimeText" Text="平均答题时间：--" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="FastestTimeText" Text="最快完成时间：--" FontSize="12" Margin="0,2"/>
                                            <TextBlock x:Name="SlowestTimeText" Text="最慢完成时间：--" FontSize="12" Margin="0,2"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 最近考试记录预览 -->
                                    <Expander Header="📅 最近考试记录预览" IsExpanded="False" Margin="0,10,0,0">
                                        <Border BorderBrush="#23395d" BorderThickness="1" CornerRadius="4" Margin="0,5,0,0">
                                            <DataGrid x:Name="RecentRecordsDataGrid" 
                                          Height="200" 
                                          AutoGenerateColumns="False" 
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          AlternatingRowBackground="#F5F5F5">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="序号" Binding="{Binding ExamSequence}" Width="60"/>
                                                    <DataGridTextColumn Header="学生姓名" Binding="{Binding StudentName}" Width="100"/>
                                                    <DataGridTextColumn Header="试卷名称" Binding="{Binding ExamInfo.ExamName}" Width="150"/>
                                                    <DataGridTextColumn Header="分数" Binding="{Binding Score}" Width="60"/>
                                                    <DataGridTextColumn Header="提交时间" Binding="{Binding SubmitTime, StringFormat=MM-dd HH:mm}" Width="100"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </GroupBox>

                            <!-- 添加底部空白区域，确保滚动体验 -->
                            <Border Height="20" Background="Transparent"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 右侧控制面板 - 保持不变 -->
        <Border Grid.Column="1" Background="#90C0A0" Margin="10">
            <DockPanel>
                <!-- 标题固定在顶部，不随滚动 -->
                <TextBlock Text="试卷管理" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10,0,15"
                   DockPanel.Dock="Top"/>

                <!-- 按钮固定在底部，不随滚动 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="GenerateButton" Content="生 成 试 卷" Height="40"
                                Background="#2196F3" Foreground="White"
                                FontSize="20" Style="{StaticResource SeriousButton}" Click="GenerateButton_Click" Width="150"/>
                        <Button x:Name="DeleteButton" Content="删 除 试 卷" Height="40" Background="#FF4081" Foreground="White"
                                Margin="0,10,10,0"  FontSize="20" Style="{StaticResource SeriousButton}" Click="DeleteButton_Click" Width="150"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ViewExamRecordsButton" Content="考 试 记 录" Width="150" Height="40" Background="#1F4081" Foreground="White"
                                FontSize="20" Style="{StaticResource SeriousButton}" Click="ViewExamRecords_Click" />
                        <Button x:Name="ExitButton" Content="退    出" Height="40" Width="150"
                                Margin="0,10,10,0" Background="#F44336" Foreground="White"
                                FontSize="20" Style="{StaticResource SeriousButton}" Click="ExitButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 中间内容区域可滚动 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              Margin="20,0,20,0">
                    <StackPanel>
                        <!-- 教师信息显示区 -->
                        <GroupBox Header="教师信息" Padding="10" Margin="0,0,0,10" Style="{StaticResource ClosedGroupBox}">
                            <StackPanel>
                                <TextBlock x:Name="TeacherNameText" Text="姓名：" FontSize="20"  FontWeight="Normal"/>
                                <TextBlock x:Name="TeacherIdText" Text="工号：" FontSize="20" Margin="0,10,0,0"  FontWeight="Normal"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 试卷名称输入 -->
                        <GroupBox Header="试卷信息" Padding="10" Margin="0,0,0,5" Style="{StaticResource ClosedGroupBox}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="试卷名称：" FontSize="20" Margin="0,0,0,5"  FontWeight="Normal"/>
                                <TextBox x:Name="ExamNameBox" Grid.Row="1" Height="30"/>

                                <!-- 添加状态提示 -->
                                <TextBlock x:Name="ExamNameStatusText" Grid.Row="2" 
                                           FontSize="12" Margin="0,2,0,0" 
                                           Foreground="Orange" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>

                        <!-- 试卷列表 -->
                        <GroupBox Header="试卷列表" Padding="5" Margin="0,2,0,2" FontSize="13" Style="{StaticResource ClosedGroupBox}">
                            <StackPanel>
                                <!-- 添加一个简单的说明文本 -->
                                <TextBlock Text="💡 点击单选按钮设为考试用卷，点击试卷名查看详情" 
                                           FontSize="10" Foreground="Firebrick" 
                                           Margin="2,2,2,2" TextWrapping="Wrap"/>
                                <TextBlock Text="     右键点击试卷名可实现设置、取消、详情查看功能" 
                                           FontSize="10" Foreground="Firebrick" 
                                           Margin="2,2,2,2" TextWrapping="Wrap"/>
                                <!-- 添加黑色外框包围试卷列表 -->
                                <Border BorderBrush="#23395d" BorderThickness="2" CornerRadius="4" Margin="0,0,0,5">
                                    <!-- 使用 ItemsControl 来显示自定义的试卷项 -->
                                    <ScrollViewer Height="185" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ExamItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#81D1DD" BorderThickness="4" 
                                                                CornerRadius="3" Margin="0,1,0,1" 
                                                                Background="{Binding BackgroundBrush}">
                                                        <Grid Margin="5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 单选按钮 -->
                                                            <RadioButton Grid.Column="0" 
                                                                             IsChecked="{Binding IsActive}"
                                                                             GroupName="ActiveExamGroup"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,8,0"
                                                                             Checked="ExamRadioButton_Checked"
                                                                             Tag="{Binding ExamName}"
                                                                             ToolTip="点击设为考试用卷"/>

                                                            <!-- 试卷名称 -->
                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{Binding ExamName}" 
                                                                       FontSize="16" 
                                                                       FontWeight="{Binding FontWeight}"
                                                                       VerticalAlignment="Center"
                                                                       MouseLeftButtonDown="ExamName_MouseLeftButtonDown"
                                                                       Cursor="Hand"
                                                                       Tag="{Binding ExamName}"
                                                                       ToolTip="点击查看试卷详情">
                                                                <!-- 添加右键菜单 -->
                                                                <TextBlock.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="设为考试用卷" Click="SetAsActiveExam_Click" Icon="⭐" FontWeight="Bold" Tag="{Binding ExamName}"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="取消考试用卷" Click="ClearActiveExam_Click" Icon="❌" FontWeight="Normal"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="查看试卷详情" Click="ViewExamDetails_Click" Icon="📄" FontWeight="Normal" Tag="{Binding ExamName}"/>
                                                                    </ContextMenu>
                                                                </TextBlock.ContextMenu>
                                                            </TextBlock>

                                                            <!-- 考卷标识 -->
                                                            <TextBlock Grid.Column="2" 
                                                                           Text="{Binding ActiveIndicator}"
                                                                           FontSize="16" FontWeight="Bold"
                                                                           Foreground="Red"
                                                                           VerticalAlignment="Center"
                                                                           Margin="5,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <Border BorderBrush="#23395d" BorderThickness="2" CornerRadius="4" Padding="4" Margin="0,5,0,0" Background="#F8F9FA">
                                    <TextBlock x:Name="ExamSummaryText"
                                               FontSize="16"
                                               Foreground="#23395d"
                                               TextWrapping="Wrap"
                                               MinHeight="150"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
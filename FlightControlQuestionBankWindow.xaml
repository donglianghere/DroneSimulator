<Window x:Class="DroneSimulator.FlightControlQuestionBankWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="飞控实操题库管理" Height="800" Width="1200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="#F8F9FA">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,10,10">
            <Separator Margin="5,0"/>
            <!-- 基本操作 -->
            <Button x:Name="AddQuestionButton" Content="新 增 题 目" Width="100" Height="35"
                    Background="#4CAF50" Foreground="White" FontSize="16" Margin="0,0,10,0"
                    Click="AddQuestion_Click"/>
            <Button x:Name="EditQuestionButton" Content="编 辑 题 目" Width="100" Height="35"
                    Background="#2196F3" Foreground="White" FontSize="16" Margin="0,0,10,0"
                    Click="EditQuestion_Click"/>
            <Button x:Name="DeleteQuestionButton" Content="删 除 题 目" Width="100" Height="35"
                    Background="#F44336" Foreground="White" FontSize="16" Margin="0,0,10,0"
                    Click="DeleteQuestion_Click"/>
            <Button x:Name="DeleteDuplicatesButton" Content="删 除 重 复" Width="100" Height="35"
                    Background="#E91E63" Foreground="White" FontSize="16" Margin="0,0,10,0"
                    Click="DeleteDuplicates_Click" 
                    ToolTip="根据题目陈述检测并删除重复题目"/>

            <Separator Margin="10,0"/>

            <!-- 导入导出 -->
            <Button x:Name="ImportButton" Content="导 入 题 库" Width="100" Height="35"
                    Background="#9C27B0" Foreground="White" FontSize="16" Margin="0,0,10,0"
                    Click="Import_Click"/>
            <Button x:Name="ExportButton" Content="导 出 题 库" Width="100" Height="35"
                    Background="#9C27B0" Foreground="White" FontSize="16" Margin="0,0,10,0"
                    Click="Export_Click"/>
            
            <!-- 选择操作 -->
            <CheckBox x:Name="SelectAllCheckBox" Content="全选" Margin="0,0,10,0" 
                      VerticalAlignment="Center" Checked="SelectAll_Checked" 
                      Unchecked="SelectAll_Unchecked" Indeterminate="SelectAll_Indeterminate"/>
            <TextBlock x:Name="SelectedCountText" Text="已选择: 0 题" VerticalAlignment="Center" 
                       Margin="0,0,15,0" Foreground="#666"/>

            <Separator Margin="10,0"/>

            <!-- 搜索 -->
            <TextBox x:Name="SearchTextBox" Width="200" Height="35" 
                     Margin="0,0,10,0" VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="搜索题目..."/>

            <Separator Margin="6,0"/>

            <Button x:Name="CloseButton" Content="关     闭" Width="90" Height="35"
                    Background="#F17575" Foreground="White" FontSize="16" HorizontalAlignment="Right"
                    Click="Close_Click"/>

            <Separator Margin="5,0"/>
        </StackPanel>

        <!-- 主要内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧筛选面板 -->
            <GroupBox Grid.Column="0" Header="筛选条件" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="题目类型：" FontWeight="Bold" Margin="5"/>
                    <ComboBox x:Name="TypeFilterComboBox" Margin="5" SelectionChanged="Filter_Changed"/>

                    <TextBlock Text="内容分类：" FontWeight="Bold" Margin="5,10,5,5"/>
                    <ComboBox x:Name="CategoryFilterComboBox" Margin="5" SelectionChanged="Filter_Changed"/>

                    <TextBlock Text="难度等级：" FontWeight="Bold" Margin="5,10,5,5"/>
                    <ComboBox x:Name="DifficultyFilterComboBox" Margin="5" SelectionChanged="Filter_Changed"/>

                    <TextBlock Text="数据类型：" FontWeight="Bold" Margin="5,10,5,5"/>
                    <ComboBox x:Name="DataTypeFilterComboBox" Margin="5" SelectionChanged="Filter_Changed"/>

                    <CheckBox x:Name="OnlyActiveCheckBox" Content="仅显示启用题目" 
                              Margin="5,10,5,5" IsChecked="True" 
                              Checked="Filter_Changed" Unchecked="Filter_Changed"/>

                    <Button x:Name="ClearFiltersButton" Content="清除筛选" Width="100" Height="30"
                            Margin="5,20,5,5" Click="ClearFilters_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- 右侧题目列表 -->
            <DataGrid x:Name="QuestionsDataGrid" Grid.Column="1"
                      AutoGenerateColumns="False"
                      SelectionMode="Extended"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False" 
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F5F5F5"
                      MouseDoubleClick="QuestionsDataGrid_MouseDoubleClick"
                      BeginningEdit="QuestionsDataGrid_BeginningEdit"
                      SelectionChanged="QuestionsDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <!-- 复选框列 -->
                    <DataGridTemplateColumn Header="选择" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="QuestionCheckBox_Changed" 
                                          Unchecked="QuestionCheckBox_Changed"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="题目ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="题目陈述" Binding="{Binding QuestionStatement}" Width="250"/>
                    <DataGridTextColumn Header="参数名称" Binding="{Binding ParameterName}" Width="120"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplayName}" Width="80"/>
                    <DataGridTextColumn Header="分类" Binding="{Binding CategoryDisplayName}" Width="100"/>
                    <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="80"/>
                    <DataGridTextColumn Header="正确值" Binding="{Binding CorrectValue}" Width="80"/>
                    <DataGridTextColumn Header="难度" Binding="{Binding DifficultyDisplayName}" Width="60"/>
                    <DataGridTextColumn Header="分值" Binding="{Binding Points}" Width="50"/>
                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="50"/>
                    <DataGridTextColumn Header="出题人" Binding="{Binding CreatedBy}" Width="80"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 底部状态栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="就绪" VerticalAlignment="Center"/>
            <Separator Margin="10,0"/>
            <TextBlock x:Name="CountTextBlock" Text="总计: 0 题" VerticalAlignment="Center"/>
            <Border Background="Transparent" Width="1" HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- 进度条面板 -->
        <Grid x:Name="ProgressPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,10,0,0">
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
                    CornerRadius="3" Padding="15">
                <StackPanel>
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock x:Name="ProgressText" Text="正在导入题库..." 
                                   VerticalAlignment="Center" FontWeight="Bold"
                                   DockPanel.Dock="Left"/>
                        <Button x:Name="CancelImportButton" Content="取消" Width="60" Height="25"
                                Background="#F44336" Foreground="White" 
                                DockPanel.Dock="Right" Margin="10,0,0,0"
                                Click="CancelImport_Click"/>
                    </DockPanel>
                    <ProgressBar x:Name="ImportProgressBar" Height="20" 
                                 Minimum="0" Maximum="100" Value="0"
                                 Background="#F0F0F0" Foreground="#2196F3"/>
                    <TextBlock x:Name="ProgressDetailText" Text="" Margin="0,5,0,0" 
                               FontSize="12" Foreground="#666"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
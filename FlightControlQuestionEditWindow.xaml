<Window x:Class="DroneSimulator.FlightControlQuestionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="飞控实操题目编辑" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <Style TargetType="GroupBox" x:Key="EditGroupBox">
            <Setter Property="Foreground" Value="#23395d"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="TextBox" x:Key="EditTextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="EditComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 可滚动的主内容区域 -->
        <ScrollViewer Grid.Row="0" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      CanContentScroll="False">
            <StackPanel>
                <!-- 基本信息 -->
                <GroupBox Header="基本信息" Style="{StaticResource EditGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="题目ID：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="QuestionIdTextBox" Grid.Row="0" Grid.Column="1" 
                                 Style="{StaticResource EditTextBox}" IsReadOnly="True"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="题目类型：" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="QuestionTypeComboBox" Grid.Row="0" Grid.Column="3" 
                                  Style="{StaticResource EditComboBox}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="分类：" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="CategoryComboBox" Grid.Row="1" Grid.Column="1" 
                                  Style="{StaticResource EditComboBox}"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="难度：" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="DifficultyComboBox" Grid.Row="1" Grid.Column="3" 
                                  Style="{StaticResource EditComboBox}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="分值：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="PointsTextBox" Grid.Row="2" Grid.Column="1" 
                                 Style="{StaticResource EditTextBox}"/>

                        <CheckBox x:Name="IsActiveCheckBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                  Content="启用题目" VerticalAlignment="Center" Margin="5"/>
                    </Grid>
                </GroupBox>

                <!-- 题目内容 -->
                <GroupBox Header="题目内容" Style="{StaticResource EditGroupBox}">
                    <StackPanel>
                        <TextBlock Text="题目陈述：" FontWeight="Bold" Margin="5"/>
                        <TextBox x:Name="QuestionStatementTextBox" 
                                 MinHeight="80" MaxHeight="120"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Disabled"
                                 Style="{StaticResource EditTextBox}"
                                 ToolTip="如：将参数MC_PITCHRATE_P设置为0.15"/>
                    </StackPanel>
                </GroupBox>

                <!-- 参数设置 -->
                <GroupBox Header="参数设置" Style="{StaticResource EditGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="参数名称：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="ParameterNameTextBox" Grid.Row="0" Grid.Column="1" 
                                 Style="{StaticResource EditTextBox}" ToolTip="如：MC_PITCHRATE_P"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="数据类型：" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="DataTypeComboBox" Grid.Row="0" Grid.Column="3" 
                                  Style="{StaticResource EditComboBox}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="参数描述：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="ParameterDescriptionTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                 Style="{StaticResource EditTextBox}" ToolTip="参数的详细说明"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="正确答案：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="CorrectValueTextBox" Grid.Row="2" Grid.Column="1" 
                                 Style="{StaticResource EditTextBox}" ToolTip="标准答案值"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="参数单位：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="UnitTextBox" Grid.Row="2" Grid.Column="3" 
                                 Style="{StaticResource EditTextBox}" ToolTip="如：V, A, Hz等"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="最小值：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="MinValueTextBox" Grid.Row="3" Grid.Column="1" 
                                 Style="{StaticResource EditTextBox}" ToolTip="参数允许的最小值"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="最大值：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="MaxValueTextBox" Grid.Row="3" Grid.Column="3" 
                                 Style="{StaticResource EditTextBox}" ToolTip="参数允许的最大值"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="容差：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="ToleranceTextBox" Grid.Row="4" Grid.Column="1" 
                                 Style="{StaticResource EditTextBox}" ToolTip="浮点数比较时的容差范围"/>

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="验证方法：" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="VerifyMethodComboBox" Grid.Row="4" Grid.Column="3" 
                                  Style="{StaticResource EditComboBox}"/>
                    </Grid>
                </GroupBox>

                <!-- 验证设置 -->
                <GroupBox Header="验证设置" Style="{StaticResource EditGroupBox}">
                    <StackPanel>
                        <CheckBox x:Name="RequireFlightControllerReadCheckBox" 
                                  Content="需要从飞控读取参数进行验证" 
                                  Margin="5" ToolTip="选中：从飞控读取实际值；不选中：学生直接输入答案"/>
                    </StackPanel>
                </GroupBox>

                <!-- 题目解析 -->
                <GroupBox Header="题目解析" Style="{StaticResource EditGroupBox}">
                    <TextBox x:Name="ExplanationTextBox" 
                             MinHeight="60" MaxHeight="100"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Disabled"
                             Style="{StaticResource EditTextBox}"
                             ToolTip="题目的详细解释说明"/>
                </GroupBox>

                <!-- 出题信息 -->
                <GroupBox Header="出题信息" Style="{StaticResource EditGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="出题人：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="CreatedByTextBox" Grid.Column="1" 
                                 Style="{StaticResource EditTextBox}"/>

                        <TextBlock Grid.Column="2" Text="创建时间：" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock x:Name="CreatedTimeTextBlock" Grid.Column="3" 
                                   VerticalAlignment="Center" Margin="5"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 固定在底部的按钮栏 -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0,1,0,0" 
                Padding="0,10,0,0"
                Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ValidateButton" Content="验证题目" Width="80" Height="35"
                        Background="#FF9800" Foreground="White" Margin="0,0,10,0"
                        Click="Validate_Click" ToolTip="验证题目数据的完整性"/>
                <Button x:Name="TestParameterButton" Content="测试参数" Width="80" Height="35"
                        Background="#9C27B0" Foreground="White" Margin="0,0,10,0"
                        Click="TestParameter_Click" ToolTip="测试与飞控的参数通信"/>
                <Button x:Name="SaveButton" Content="保存" Width="80" Height="35"
                        Background="#2196F3" Foreground="White" Margin="0,0,10,0"
                        Click="Save_Click"/>
                <Button x:Name="CancelButton" Content="取消" Width="80" Height="35"
                        Background="#757575" Foreground="White"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
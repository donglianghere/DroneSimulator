<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:DroneSimulator"
        mc:Ignorable="av" 
        x:Class="DroneSimulator.MainWindow"
        Title="康鹤多旋翼无人机检修平台-V2.0" Height="1280" Width="1920"
        Background="#FF667EEA"
        ResizeMode="CanMinimize"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        Topmost="True"
        Icon="/Resources/drone-icon.png">
    <!-- 资源定义 -->
    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" 
                          ShadowDepth="5" BlurRadius="10" 
                          Color="Black" Opacity="0.3"/>
        <RotateTransform x:Key="PropellerRotation" Angle="0"/>
        <!-- 圆形透明按钮样式 -->
        <Style x:Key="CircularRepairButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Ellipse x:Name="ButtonEllipse" 
                                     Fill="Transparent" 
                                     Stroke="Goldenrod" 
                                     StrokeThickness="8"/>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonEllipse" Property="Fill" Value="#30DAA520"/>
                                <Setter TargetName="ButtonEllipse" Property="Stroke" Value="Orange"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonEllipse" Property="Fill" Value="#50DAA520"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonEllipse" Property="Fill" Value="Gray"/>
                                <Setter TargetName="ButtonEllipse" Property="Stroke" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <!-- 理论题选项按钮样式 -->
        <Style x:Key="TheoryOptionButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="OptionBorder" 
                                Background="LightGray" 
                                BorderBrush="DarkGray" 
                                BorderThickness="2" 
                                CornerRadius="5" 
                                Padding="10,5" 
                                Margin="5,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="LightBlue"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="LightGreen"/>
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="Green"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 飞控参数输入框样式 -->
        <Style x:Key="FCParameterTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="Blue"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 🚀 新增：缺失的转换器 -->
        <!-- 飞控题目类型到可见性转换器 -->
        <local:FCQuestionTypeToVisibilityConverter x:Key="FCQuestionTypeToVisibilityConverter"/>
        <!-- 字符串到可见性转换器 -->
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

    </Window.Resources>


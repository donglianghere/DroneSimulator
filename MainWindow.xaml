    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" 
                          ShadowDepth="5" BlurRadius="10" 
                          Color="Black" Opacity="0.3"/>
        <RotateTransform x:Key="PropellerRotation" Angle="0"/>
        <!-- 圆形透明按钮样式 -->
        <Style x:Key="CircularRepairButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Ellipse x:Name="ButtonEllipse" 
                                     Fill="Transparent" 
                                     Stroke="Goldenrod" 
                                     StrokeThickness="8"/>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonEllipse" Property="Fill" Value="#30DAA520"/>
                                <Setter TargetName="ButtonEllipse" Property="Stroke" Value="Orange"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonEllipse" Property="Fill" Value="#50DAA520"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonEllipse" Property="Fill" Value="Gray"/>
                                <Setter TargetName="ButtonEllipse" Property="Stroke" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>
    </Window.Resources>

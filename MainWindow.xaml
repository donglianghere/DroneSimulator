<Window x:Class="DroneSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="康鹤多旋翼无人机检修平台-V1.0" Height="680" Width="800"
        Background="#FF667EEA"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Icon="/Resources/drone-icon.png">
    <!-- 资源定义 -->
    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" 
                      ShadowDepth="5" BlurRadius="10" 
                      Color="Black" Opacity="0.3"/>
        <RotateTransform x:Key="PropellerRotation" Angle="0"/>
    </Window.Resources>
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>       

        <!-- 主要内容区域 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="LeftPanel" Grid.Column="0" Margin="10"/>

            <!-- 右侧 - 控制面板 -->
            <Border Grid.Column="1" Background="White" CornerRadius="15" 
                    Margin="5" Padding="5"
                    Effect="{StaticResource DropShadowEffect}">
                <StackPanel>
                    <TextBlock Text="控制面板" FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- 速度控制 -->
                    <GroupBox Header="速度控制" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="油门:" Margin="0,5"/>
                            <Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" 
                                  Value="0" TickFrequency="10" IsSnapToTickEnabled="True"
                                  ValueChanged="SpeedSlider_ValueChanged"/>
                            <TextBlock x:Name="SpeedValue" Text="0%" 
                                     HorizontalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 控制按钮 -->
                    <GroupBox Header="电机控制" Margin="0,20,0,10">
                        <StackPanel>
                            <Button x:Name="StartButton" Content="▶️ 启动" 
                                  Height="40" Margin="0,5" 
                                  Background="#4CAF50" Foreground="White"
                                  FontSize="16" FontWeight="Bold"
                                  Click="StartButton_Click"/>

                            <Button x:Name="StopButton" Content="⏹️ 停止" 
                                  Height="40" Margin="0,5"
                                  Background="#f44336" Foreground="White"
                                  FontSize="16" FontWeight="Bold"
                                  Click="StopButton_Click"/>

                            <Button x:Name="TestButton" Content="🔧 测试旋转" 
                                  Height="40" Margin="0,5"
                                  Background="#FF9800" Foreground="White"
                                  FontSize="16" FontWeight="Bold"
                                  Click="TestButton_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 技术参数 -->
                    <GroupBox Header="技术参数" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="• 电机类型: 无刷直流电机" Margin="2"/>
                            <TextBlock Text="• 工作电压: 11.1V - 14.8V" Margin="2"/>
                            <TextBlock Text="• 最大转速: 8000 RPM" Margin="2"/>
                            <TextBlock Text="• 螺旋桨: 10英寸 x 4.5螺距" Margin="2"/>
                            <TextBlock Text="• ESC规格: 30A" Margin="2"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>


</Window>
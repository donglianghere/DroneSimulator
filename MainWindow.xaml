                                                          FontSize="16" FontWeight="Bold" 
                                                          Margin="0,0,0,10" TextWrapping="Wrap"/>

                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <RadioButton Content="{Binding}" 
                                                                        Style="{StaticResource TheoryOptionButtonStyle}"
                                                                        GroupName="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=DataContext.Id}"
                                                                        Tag="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=DataContext}"
                                                                        Click="TheoryOption_Click"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

<Window x:Class="DroneSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无人机螺旋桨控制系统" Height="680" Width="800"
        Background="#FF667EEA">
    <!-- 资源定义 -->
    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" 
                      ShadowDepth="5" BlurRadius="10" 
                      Color="Black" Opacity="0.3"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="🚁 无人机螺旋桨控制系统" 
                   FontSize="28" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" Margin="20"/>

        <!-- 主要内容区域 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧 - 螺旋桨显示区域 -->
            <Border Grid.Column="0" Background="White" CornerRadius="15" 
                    Margin="10" Padding="20" 
                    Effect="{StaticResource DropShadowEffect}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="螺旋桨状态" FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- 螺旋桨容器 -->
                    <Viewbox Width="264" Height="305" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Canvas x:Name="PropellerCanvas" Width="120" Height="120">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="PropellerRotation" CenterX="60" CenterY="60" Angle="0"/>
                            </Canvas.RenderTransform>
                            <!-- 8个叶片，全部以中心为原点 -->
                            <Rectangle Width="6" Height="40" Fill="#2196F3"
                   RadiusX="3" RadiusY="3"
                   Canvas.Left="57" Canvas.Top="20"
                   RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="6" Height="40" Fill="#2196F3"
                   RadiusX="3" RadiusY="3"
                   Canvas.Left="57" Canvas.Top="20"
                   RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="6" Height="40" Fill="#2196F3"
                   RadiusX="3" RadiusY="3"
                   Canvas.Left="57" Canvas.Top="20"
                   RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="6" Height="40" Fill="#2196F3"
                   RadiusX="3" RadiusY="3"
                   Canvas.Left="57" Canvas.Top="20"
                   RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="135"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="6" Height="40" Fill="#2196F3"
                   RadiusX="3" RadiusY="3"
                   Canvas.Left="57" Canvas.Top="20"
                   RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="180"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="6" Height="40" Fill="#2196F3"
                   RadiusX="3" RadiusY="3"
                   Canvas.Left="57" Canvas.Top="20"
                   RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="225"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="6" Height="40" Fill="#2196F3"
                   RadiusX="3" RadiusY="3"
                   Canvas.Left="57" Canvas.Top="20"
                   RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="270"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="6" Height="40" Fill="#2196F3"
                   RadiusX="3" RadiusY="3"
                   Canvas.Left="57" Canvas.Top="20"
                   RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="315"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <!-- 电机中心 -->
                            <Ellipse Width="20" Height="20" Fill="#333" Opacity="0.7"
                 Canvas.Left="50" Canvas.Top="50"
                 Stroke="#666" StrokeThickness="2"/>
                        </Canvas>
                    </Viewbox>

                    <!-- RPM显示 -->
                    <TextBlock Grid.Row="2" x:Name="RpmDisplay" Text="转速: 0 RPM" 
                             FontSize="16" FontWeight="Bold" Foreground="#2196F3"
                             HorizontalAlignment="Center" Margin="10"/>

                    <!-- 状态指示器 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <TextBlock Text="状态: " FontSize="14" VerticalAlignment="Center"/>
                        <Ellipse x:Name="StatusIndicator" Width="16" Height="16" 
                               Fill="#f44336" Margin="5,0"/>
                        <TextBlock x:Name="StatusText" Text="停止" FontSize="14" 
                                 VerticalAlignment="Center" Foreground="#f44336"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧 - 控制面板 -->
            <Border Grid.Column="1" Background="White" CornerRadius="15" 
                    Margin="10" Padding="20"
                    Effect="{StaticResource DropShadowEffect}">
                <StackPanel>
                    <TextBlock Text="控制面板" FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- 速度控制 -->
                    <GroupBox Header="速度控制" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="油门:" Margin="0,5"/>
                            <Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" 
                                  Value="0" TickFrequency="10" IsSnapToTickEnabled="True"
                                  ValueChanged="SpeedSlider_ValueChanged"/>
                            <TextBlock x:Name="SpeedValue" Text="0%" 
                                     HorizontalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 控制按钮 -->
                    <GroupBox Header="电机控制" Margin="0,20,0,10">
                        <StackPanel>
                            <Button x:Name="StartButton" Content="▶️ 启动" 
                                  Height="40" Margin="0,5" 
                                  Background="#4CAF50" Foreground="White"
                                  FontSize="16" FontWeight="Bold"
                                  Click="StartButton_Click"/>

                            <Button x:Name="StopButton" Content="⏹️ 停止" 
                                  Height="40" Margin="0,5"
                                  Background="#f44336" Foreground="White"
                                  FontSize="16" FontWeight="Bold"
                                  Click="StopButton_Click"/>

                            <Button x:Name="TestButton" Content="🔧 测试旋转" 
                                  Height="40" Margin="0,5"
                                  Background="#FF9800" Foreground="White"
                                  FontSize="16" FontWeight="Bold"
                                  Click="TestButton_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 技术参数 -->
                    <GroupBox Header="技术参数" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="• 电机类型: 无刷直流电机" Margin="2"/>
                            <TextBlock Text="• 工作电压: 11.1V - 14.8V" Margin="2"/>
                            <TextBlock Text="• 最大转速: 8000 RPM" Margin="2"/>
                            <TextBlock Text="• 螺旋桨: 10英寸 x 4.5螺距" Margin="2"/>
                            <TextBlock Text="• ESC规格: 30A" Margin="2"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>


</Window>
                <!-- 飞控实操页面 - 简化版本 -->
                <TabItem Header="飞控实操" x:Name="FlightControlTab">
                    <ScrollViewer x:Name="FCScrollViewer" VerticalScrollBarVisibility="Auto" Margin="10">
                        <StackPanel x:Name="FCQuestionsPanel" Margin="20">
                            <TextBlock Text="飞控参数设置实操" FontSize="28" FontWeight="Bold" 
                      HorizontalAlignment="Center" Margin="0,0,0,20" 
                      Foreground="#2D3A4A"/>

                            <TextBlock Text="请根据题目要求，设置或查看飞控参数值。操作完成后点击“验证”按钮。" 
                      FontSize="16" Margin="0,0,0,20" 
                      Foreground="DarkSlateGray" TextWrapping="Wrap"/>

                            <!-- 飞控连接状态 -->
                            <Border Background="LightYellow" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="飞控连接状态：" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="FCConnectionStatusText" Text="未连接" FontSize="14" 
                              Foreground="Red" Margin="5,0,0,0"/>
                                    <Button x:Name="BtnConnectFC" Content="连接飞控" FontSize="12" 
                           Width="80" Height="25" Margin="20,0,0,0" 
                           Click="ConnectFC_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- 🔧 简化：使用基本的ItemsControl，减少复杂的数据绑定 -->
                            <ItemsControl x:Name="FCQuestionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" CornerRadius="8" Margin="0,10" 
                               Padding="15" BorderBrush="LightGray" BorderThickness="1">
                                            <StackPanel>
                                                <!-- 题目描述 -->
                                                <TextBlock Text="{Binding QuestionStatement}" 
                                          FontSize="16" FontWeight="Bold" 
                                          Margin="0,0,0,10" TextWrapping="Wrap"/>

                                                <!-- 参数信息 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                                    <TextBlock Text="参数名：" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ParameterName}" 
                                              FontSize="14" FontWeight="Bold" 
                                              VerticalAlignment="Center" Margin="5,0"/>
                                                </StackPanel>

                                                <!-- 输入和验证区域 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                                    <TextBlock Text="设置值：" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="ParameterValueTextBox" Width="150" Height="25"
                                            Margin="5,0"/>
                                                    <Button Content="验证" FontSize="12" Width="60" Height="25" 
                                           Margin="10,0,0,0" Click="VerifyFCAnswer_Click" 
                                           Tag="{Binding}"/>
                                                </StackPanel>

                                                <!-- 说明文字 -->
                                                <TextBlock Text="{Binding Explanation}" 
                                          FontSize="12" Foreground="Gray" 
                                          Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- 右侧 - 控制面板 -->
            <Border Grid.Column="1" Background="White" CornerRadius="15" 
                    Margin="20,20,20,0" Padding="10"
                    Effect="{StaticResource DropShadowEffect}">
                <DockPanel>
                    <!-- 顶部标题固定 -->
                    <TextBlock Text="答题面板" FontSize="30" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,-4,0,20"
                               DockPanel.Dock="Top"/>

                    <!-- 底部按钮固定 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                                Margin="0,10,0,5" DockPanel.Dock="Bottom">
                        <Button x:Name="ExitButton" Content="退  出" FontSize="26" 
                                FontWeight="Bold" Width="100" Height="40" Margin="20,0" 
                                Background="Red" Click="ExitButton_Click"/>
                        <Button x:Name="SubmitButton" Content="提  交" FontSize="26" 
                                FontWeight="Bold" Width="100" Height="40" Margin="20,0" 
                                Background="#5EC6FF" Click="SubmitButton_Click"/>
                    </StackPanel>

                    <!-- 中间内容区域可滚动 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" >
                        <StackPanel>
                            <TextBlock Text="答题须知" FontSize="18" FontWeight="Bold" 
                                       Foreground="#2D3A4A" Margin="15,0,0,6"/>
                            <Border Background="#F8F9FA" CornerRadius="6" Padding="10" 
                                    Margin="0,0,0,18" BorderBrush="#2D3A4A" BorderThickness="1" 
                                    Height="133">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="1. 特别提醒：考生须仔细核实考试信息，如身份是否相符，考试设备是否正常连接，试卷是否已经载入；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="2. 理论试卷：选择正确答案，每题只能选择一个选项；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="3. 电路检测：检查各元器件连接情况，对中断的连接点击“修复”按钮；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="4. 飞控实操：根据题目要求设置参数值，点击“验证”按钮确认；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="5. 每处连接最多只能进行一次修复操作，修复后按钮变色表示已作答；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="6. 无法看见的答题区域，可使用滚动条或按住“Ctrl”键+鼠标滚轮进行缩放；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="7. 所有题目完成后请点击“提交”按钮交卷，然后点击“退出”按钮结束测试。" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="LoadingProgressText"
                                           Text="正在加载试题和初始化设备，请稍候..."
                                           FontSize="14"
                                           Foreground="DarkSlateGray"
                                           HorizontalAlignment="Left"
                                           Margin="2,0,0,2"/>
                                <ProgressBar x:Name="LoadingProgressBar"
                                             Height="20"
                                             Margin="0,0,0,10"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Visibility="Collapsed"/>
                            </StackPanel>
                            <GroupBox Header="考试信息" Margin="0,0,0,20" FontSize="18" FontWeight="Bold">
                                <StackPanel>
                                    <TextBlock x:Name="StudentNameText" Text="考生姓名：" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <TextBlock x:Name="StudentIdText" Text="身份证号：" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <TextBlock x:Name="ExamTitleText" Text="试题名称：" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <TextBlock x:Name="ExamTeacherText" Text="出题老师：" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <TextBlock x:Name="ExamMachineText" Text="考试设备：正在初始化试题！" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <TextBlock x:Name="RepairPortStatusText" Text="检修端口：正在检测..." 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <TextBlock x:Name="ExamScoreText" Text="考试得分：" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <ListView x:Name="ExamStatListView" Margin="0,8,0,0" 
                                               Height="154" BorderThickness="1">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="统计项" Width="100" 
                                                                DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="数值" Width="100" 
                                                                DisplayMemberBinding="{Binding Value}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
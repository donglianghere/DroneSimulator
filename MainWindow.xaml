<Window x:Class="DroneSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="多旋翼无人机检修平台-V1.0" Height="1080" Width="1920"
        Background="#FF667EEA"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Icon="/Resources/drone-icon.png">
    <!-- 资源定义 -->
    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" 
                      ShadowDepth="5" BlurRadius="10" 
                      Color="Black" Opacity="0.3"/>
        <RotateTransform x:Key="PropellerRotation" Angle="0"/>
    </Window.Resources>
    <Grid Margin="0,0,-33,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="121*"/>
            <RowDefinition Height="234*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主要内容区域 -->
        <Grid Grid.Row="1" Margin="20,20,20,20" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧 - TabControl -->
            <TabControl x:Name="MainTabControl" Grid.Column="0" Margin="0">
                <!-- 第一个页面 -->
                <TabItem Header="GPS～飞控～接收机">
                    <ScrollViewer x:Name="MainScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="10,0,-10,0">
                        <Canvas x:Name="ZoomCanvas" Background="White" Width="1798" Height="900" Margin="100,0,0,0">
                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                            </Canvas.LayoutTransform>
                            <!-- 第一条线 -->
                            <Button Content="修  复" Tag="GPS5V_2" Panel.ZIndex="1" FontSize="25" Background="Goldenrod" Width="100" Height="60" Canvas.Left="462" Canvas.Top="232" HorizontalAlignment="Left" VerticalAlignment="Center" Click="RepairButton_Click"/>
                            <!-- 第二条线 -->
                            <Button Content="修  复" Tag="UART_1" Panel.ZIndex="1" FontSize="25" Background="Goldenrod" Width="100" Height="60" Canvas.Left="462" Canvas.Top="322" HorizontalAlignment="Left" VerticalAlignment="Center" Click="RepairButton_Click"/>
                            <!-- 第三条线 -->
                            <Button Content="修  复" Tag="UART_2" Panel.ZIndex="1" FontSize="25" Background="Goldenrod" Width="100" Height="60" Canvas.Left="462" Canvas.Top="412" HorizontalAlignment="Left" VerticalAlignment="Center" Click="RepairButton_Click"/>
                            <!-- 第四条线 -->
                            <Button Content="修  复" Tag="GPS5V_1" Panel.ZIndex="1" FontSize="25" Background="Goldenrod" Width="100" Height="60" Canvas.Left="462" Canvas.Top="502" HorizontalAlignment="Left" VerticalAlignment="Center" Click="RepairButton_Click"/>
                            <!-- 第一条线 -->
                            <Button Content="修  复" Tag="Receiver_3" Panel.ZIndex="1" FontSize="25" Background="Goldenrod" Width="100" Height="60" Canvas.Left="1110" Canvas.Top="287" HorizontalAlignment="Left" VerticalAlignment="Center" Click="RepairButton_Click"/>
                            <!-- 第二条线 -->
                            <Button Content="修  复" Tag="Receiver_1" Panel.ZIndex="1" FontSize="25" Background="Goldenrod" Width="100" Height="60" Canvas.Left="1110" Canvas.Top="363" HorizontalAlignment="Left" VerticalAlignment="Center" Click="RepairButton_Click"/>
                            <!-- 第三条线 -->
                            <Button Content="修  复" Tag="Receiver_2" Panel.ZIndex="1" FontSize="25" Background="Goldenrod" Width="100" Height="60" Canvas.Left="1110" Canvas.Top="444" HorizontalAlignment="Left" VerticalAlignment="Center" Click="RepairButton_Click"/>
                            <Image Panel.ZIndex="1" Height="350" Source="/Image3.png" Stretch="Fill" Width="148" Canvas.Left="1381" Canvas.Top="167" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Image Panel.ZIndex="1" Height="308" Source="/Image4.png" Stretch="Fill" Width="301" Canvas.Left="34" Canvas.Top="248" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Image x:Name="V5" Panel.ZIndex="1" Height="402" Source="/Image5.png" Stretch="Fill" Width="246" Canvas.Left="699" Canvas.Top="187" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Panel.ZIndex="0" Height="17" Fill="Gray" Canvas.Left="395" Stroke="Black" Canvas.Top="254" Width="235" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Label Panel.ZIndex="1" Content="RX" FontSize="20" FontWeight="Bold" Canvas.Left="331" Canvas.Top="334" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Label Panel.ZIndex="1" Content="TX" FontSize="20" FontWeight="Bold" Canvas.Left="331" Canvas.Top="424" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Label Panel.ZIndex="1" Content="5V" FontSize="20" FontWeight="Bold" Canvas.Left="331" Canvas.Top="514" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Label Panel.ZIndex="1" Content="—" FontSize="20" FontWeight="Bold" Canvas.Left="971" Canvas.Top="297" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Label Panel.ZIndex="1" Content="TX" FontSize="20" FontWeight="Bold" Canvas.Left="659" Canvas.Top="334" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Label Panel.ZIndex="1" Content="RX" FontSize="20" FontWeight="Bold" Canvas.Left="659" Canvas.Top="424" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Label Panel.ZIndex="1" Content="5V" FontSize="20" FontWeight="Bold" Canvas.Left="659" Canvas.Top="514" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Label Panel.ZIndex="1" Content="—" FontSize="20" FontWeight="Bold" Canvas.Left="659" Canvas.Top="245" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Panel.ZIndex="0" Height="17" Fill="Gray" Canvas.Left="395" Stroke="Black" Canvas.Top="344" Width="235" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Panel.ZIndex="0" Height="17" Fill="Gray" Canvas.Left="395" Stroke="Black" Canvas.Top="436" Width="235" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Panel.ZIndex="0" Height="17" Fill="Gray" Canvas.Left="395" Stroke="Black" Canvas.Top="524" Width="235" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Panel.ZIndex="0" Height="17" Fill="Gray" Canvas.Left="1033" Stroke="Black" Canvas.Top="462" Width="260" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Panel.ZIndex="0" Height="17" Fill="Gray" Canvas.Left="1033" Stroke="Black" Canvas.Top="387" Width="260" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Rectangle Panel.ZIndex="0" Height="17" Fill="Gray" Canvas.Left="1033" Stroke="Black" Canvas.Top="312" Width="260" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Rectangle RadiusX="30" RadiusY="30" Panel.ZIndex="0" HorizontalAlignment="Left" StrokeThickness="5" Height="558" Grid.Row="1" Stroke="BlueViolet" VerticalAlignment="Center" Width="408" Grid.RowSpan="2" Canvas.Left="625" Canvas.Top="142"/>
                            <Label Content="飞  控" FontSize="40" FontWeight="Bold" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Center" RenderTransformOrigin="0.097,0.449" Canvas.Left="778" Canvas.Top="600"/>
                            <Rectangle RadiusX="30" RadiusY="30" Panel.ZIndex="0" StrokeThickness="5" Height="558" Stroke="Blue" Width="384" Canvas.Left="11" Canvas.Top="142" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Label Content="GPS" FontSize="40" FontWeight="Bold" RenderTransformOrigin="0.097,0.449" Canvas.Left="140" Canvas.Top="600" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle RadiusX="30" RadiusY="30" Panel.ZIndex="0" StrokeThickness="5" Height="558" Stroke="LawnGreen" Width="285" Canvas.Left="1289" Canvas.Top="142" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Label Content="接收机" FontSize="40" FontWeight="Bold" RenderTransformOrigin="0.097,0.449" Canvas.Left="1370" Canvas.Top="600" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Label Panel.ZIndex="1" Content="—" FontSize="20" FontWeight="Bold" Canvas.Left="331" Canvas.Top="245" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Label Panel.ZIndex="1" Content="5V" FontSize="20" FontWeight="Bold" Canvas.Left="965" Canvas.Top="378" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Label Panel.ZIndex="1" Content="—" FontSize="20" FontWeight="Bold" Canvas.Left="1325" Canvas.Top="297" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Label Panel.ZIndex="1" Content="5V" FontSize="20" FontWeight="Bold" Canvas.Left="1319" Canvas.Top="378" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Label Panel.ZIndex="1" Content="  SBUS" FontSize="20" FontWeight="Bold" Canvas.Left="931" Canvas.Top="453" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Left" VerticalAlignment="Center" Width="87"/>
                            <Label Panel.ZIndex="1" Content="SBUS" FontSize="20" FontWeight="Bold" Canvas.Left="1317" Canvas.Top="453" RenderTransformOrigin="1.899,0.523" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <!-- 第九列：矩形 (宽240，高300) - 垂直居中 -->
                        </Canvas>
                    </ScrollViewer>
                </TabItem>

                <!-- 可以继续添加更多页面 -->
                <TabItem Header="电机～电调～飞控和电源">
                    <TextBlock Text="第二个页面内容待添加" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                </TabItem>
                <TabItem Header="扩展～飞控和电源">
                    <TextBlock Text="第三个页面内容待添加" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                </TabItem>                
            </TabControl>

            <!-- 右侧 - 控制面板 -->
            <Border Grid.Column="1" Background="White" CornerRadius="15" 
                    Margin="20,20,20,0" Padding="10"
                    Effect="{StaticResource DropShadowEffect}">
                <StackPanel>
                    <TextBlock Text="答题面板" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-4,0,20"/>
                    <TextBlock Text="答题须知" FontSize="18" FontWeight="Bold" Foreground="#2D3A4A" Margin="15,0,0,6"/>
                    <Border Background="#F8F9FA" CornerRadius="6" Padding="10" Margin="0,0,0,18" BorderBrush="#2D3A4A" BorderThickness="1" Height="133">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="1. 特别提醒：考生须仔细核实考试信息，如身份是否相符，考试设备是否正常连接，试卷是否已经载入；" TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                <TextBlock Text="2. 请仔细检查各元器件连接情况，对中断的连接，点击对应的“修复”按钮，系统会自动完成线路修复；" TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                <TextBlock Text="3. 每处连接最多只能进行一次上述的修复操作，修复后按钮变色表示已作答，请确保检测结果无误后再进行操作；" TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                <TextBlock Text="4. 对于没有问题的连接，请不要点击相应的“修复”按钮，否则计为“误修复”并扣除相应分数；" TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                <TextBlock Text="5. 所有题目修复完成后请点击“提交”按钮交卷，而后点击“退出”按钮结束测试；" TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                <TextBlock Text="6. 答题过程中如遇设备异常请及时联系监考老师。" TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="LoadingProgressText"
                                   Text="正在加载试题和初始化设备，请稍候..."
                                   FontSize="14"
                                   Foreground="DarkSlateGray"
                                   HorizontalAlignment="Left"
                                   Margin="2,0,0,2"/>
                        <ProgressBar x:Name="LoadingProgressBar"
                                     Height="20"
                                     Margin="0,0,0,10"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Visibility="Collapsed"/>
                    </StackPanel>
                    <GroupBox Header="考试信息" Margin="0,0,0,20" FontSize="18" FontWeight="Bold" >
                        <StackPanel>
                            <TextBlock x:Name="StudentNameText" Text="考生姓名：" FontSize="16" FontWeight="Normal" Margin="0,4"/>
                            <TextBlock x:Name="StudentIdText" Text="身份证号：" FontSize="16" FontWeight="Normal" Margin="0,4"/>
                            <TextBlock x:Name="ExamTitleText" Text="试题名称：" FontSize="16" FontWeight="Normal" Margin="0,4"/>
                            <TextBlock x:Name="ExamTeacherText" Text="出题老师：" FontSize="16" FontWeight="Normal" Margin="0,4"/>
                            <TextBlock x:Name="ExamMachineText" Text="考试设备：正在初始化试题！" FontSize="16" FontWeight="Normal" Margin="0,4"/>
                            <TextBlock x:Name="ExamScoreText" Text="考试得分：" FontSize="16" FontWeight="Normal" Margin="0,4"/>
                            <ListView x:Name="ExamStatListView" Margin="0,8,0,0" Height="154" BorderThickness="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="统计项" Width="100" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="数值" Width="100" DisplayMemberBinding="{Binding Value}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </GroupBox>

                    <!-- 控制按钮区 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="ExitButton" Content="退  出" FontSize="26" FontWeight="Bold" Width="100" Height="40" Margin="20,0" Background="Red" Click="ExitButton_Click"/>
                        <Button x:Name="SubmitButton" Content="提  交" FontSize="26" FontWeight="Bold" Width="100" Height="40" Margin="20,0" Background="#5EC6FF" Click="SubmitButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
                            <Button Content="修  复" Tag="SERVO_2" Panel.ZIndex="1" FontSize="25" Background="Goldenrod" Width="78" Height="45" Canvas.Left="258" Click="RepairButton_Click" Canvas.Top="10" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Button Content="修  复" Tag="SERVO_1" Panel.ZIndex="1" FontSize="25" Background="Goldenrod" Width="78" Height="45" Canvas.Left="258" Click="RepairButton_Click" Canvas.Top="68" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Button Content="修  复" Tag="Battery_2" Panel.ZIndex="1" FontSize="25" Background="Goldenrod" Width="78" Height="45" Canvas.Left="1013" Click="RepairButton_Click" Canvas.Top="10" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Button Content="修  复" Tag="Battery_1" Panel.ZIndex="1" FontSize="25" Background="Goldenrod" Width="78" Height="45" Canvas.Left="1013" Click="RepairButton_Click" Canvas.Top="68" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Rectangle RadiusX="30" RadiusY="30" Panel.ZIndex="0" StrokeThickness="5" Height="261" Stroke="BlueViolet" Width="292" Canvas.Left="546" Canvas.Top="414" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </Canvas>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <!-- 右侧 - 控制面板 -->
            <Border Grid.Column="1" Background="White" CornerRadius="15" 
                    Margin="20,20,20,0" Padding="10"
                    Effect="{StaticResource DropShadowEffect}">
                <DockPanel>
                    <!-- 顶部标题固定 -->
                    <TextBlock Text="答题面板" FontSize="30" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,-4,0,20"
                               DockPanel.Dock="Top"/>

                    <!-- 底部按钮固定 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                                Margin="0,10,0,5" DockPanel.Dock="Bottom">
                        <Button x:Name="ExitButton" Content="退  出" FontSize="26" 
                                FontWeight="Bold" Width="100" Height="40" Margin="20,0" 
                                Background="Red" Click="ExitButton_Click"/>
                        <Button x:Name="SubmitButton" Content="提  交" FontSize="26" 
                                FontWeight="Bold" Width="100" Height="40" Margin="20,0" 
                                Background="#5EC6FF" Click="SubmitButton_Click"/>
                    </StackPanel>

                    <!-- 中间内容区域可滚动 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" >
                        <StackPanel>
                            <TextBlock Text="答题须知" FontSize="18" FontWeight="Bold" 
                                       Foreground="#2D3A4A" Margin="15,0,0,6"/>
                            <Border Background="#F8F9FA" CornerRadius="6" Padding="10" 
                                    Margin="0,0,0,18" BorderBrush="#2D3A4A" BorderThickness="1" 
                                    Height="133">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="1. 特别提醒：考生须仔细核实考试信息，如身份是否相符，考试设备是否正常连接，试卷是否已经载入；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="2. 请仔细检查各元器件连接情况，对中断的连接，点击对应的按钮，系统会自动完成线路修复；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="3. 每处连接最多只能进行一次上述的修复操作，修复后按钮变色表示已作答，请确保检测结果无误后再进行操作；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="4. 对于没有问题的连接，请不要点击相应的“修复”按钮，否则计为“误答题”并扣除相应分数；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="5. 无法看见的答题区域，可以操作滚动条将不可见区域移致可视区域，或按住“Ctrl”键，使用加鼠标滚轮进行缩放；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="6. 所有题目修复完成后请点击“提交”按钮交卷，而后点击“退出”按钮结束测试；" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                        <TextBlock Text="7. 答题过程中如遇设备异常请及时联系监考老师。" 
                                                   TextWrapping="Wrap" FontSize="15" Margin="0,2"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="LoadingProgressText"
                                           Text="正在加载试题和初始化设备，请稍候..."
                                           FontSize="14"
                                           Foreground="DarkSlateGray"
                                           HorizontalAlignment="Left"
                                           Margin="2,0,0,2"/>
                                <ProgressBar x:Name="LoadingProgressBar"
                                             Height="20"
                                             Margin="0,0,0,10"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Visibility="Collapsed"/>
                            </StackPanel>
                            <GroupBox Header="考试信息" Margin="0,0,0,20" FontSize="18" FontWeight="Bold">
                                <StackPanel>
                                    <TextBlock x:Name="StudentNameText" Text="考生姓名：" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <TextBlock x:Name="StudentIdText" Text="身份证号：" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <TextBlock x:Name="ExamTitleText" Text="试题名称：" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <TextBlock x:Name="ExamTeacherText" Text="出题老师：" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <TextBlock x:Name="ExamMachineText" Text="考试设备：正在初始化试题！" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <TextBlock x:Name="ExamScoreText" Text="考试得分：" 
                                               FontSize="16" FontWeight="Normal" Margin="0,4"/>
                                    <ListView x:Name="ExamStatListView" Margin="0,8,0,0" 
                                               Height="154" BorderThickness="1">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="统计项" Width="100" 
                                                                DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="数值" Width="100" 
                                                                DisplayMemberBinding="{Binding Value}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
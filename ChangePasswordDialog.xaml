<Window x:Class="DroneSimulator.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更改密码" Height="334" Width="349"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#181F2A"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- 科技感文本框 -->
        <Style x:Key="TechTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TechPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30,30,10,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="40"/>
			<RowDefinition Height="40"/>
			<RowDefinition Height="40"/>
			<RowDefinition Height="40"/>
			<RowDefinition Height="40"/>
			<RowDefinition Height="40"/>
		</Grid.RowDefinitions>
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
			<TextBlock Text="账户类型：" FontSize="18" Width="90" VerticalAlignment="Center" Foreground="#5EC6FF"/>
			<TextBox x:Name="TypeTextBox" Width="190" FontSize="18" IsReadOnly="True" Background="#232F3E" Foreground="#5EC6FF" HorizontalContentAlignment="Center"/>
		</StackPanel>
		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
			<TextBlock Text="姓名：" FontSize="18" Width="90" VerticalAlignment="Center" Foreground="#5EC6FF"/>
            <TextBox x:Name="NameTextBox" FontSize="18" Width="190" IsReadOnly="True" Background="#232F3E" Foreground="#5EC6FF" HorizontalContentAlignment="Center" Style="{StaticResource TechTextBox}"/>
		</StackPanel>
		<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
			<TextBlock Text="身份证号：" FontSize="18" Width="90" VerticalAlignment="Center" Foreground="#5EC6FF"/>
            <TextBox x:Name="IdTextBox" FontSize="18" Width="190" IsReadOnly="True" Background="#232F3E" Foreground="#5EC6FF" HorizontalContentAlignment="Center" Style="{StaticResource TechTextBox}"/>
		</StackPanel>
		<StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
			<TextBlock Text="新密码：" FontSize="18" Width="90" VerticalAlignment="Center" Foreground="#5EC6FF"/>
            <PasswordBox x:Name="PasswordBox" TabIndex="0" FontSize="18" Width="190" HorizontalContentAlignment="Center" Style="{StaticResource TechPasswordBox}"/>
		</StackPanel>
		<StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
			<TextBlock Text="重复密码：" FontSize="18" Width="90" VerticalAlignment="Center" Foreground="#5EC6FF"/>
            <PasswordBox x:Name="RepeatPasswordBox" TabIndex="1" FontSize="18" Width="190" HorizontalContentAlignment="Center" Style="{StaticResource TechPasswordBox}"/>
		</StackPanel>
		<StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,0">
			<Button Content="取    消" Width="120" Height="36" 
					Background="#232F3E" Foreground="#5EC6FF" BorderBrush="#5EC6FF" BorderThickness="2"
					FontWeight="Bold" FontSize="20" TabIndex="3" Click="CancelButton_Click"/>
			<Button Content="更改密码" Width="120" Height="36" VerticalAlignment="Center"  Margin="40,0,0,0"
					Background="#232F3E" Foreground="#5EC6FF" BorderBrush="#5EC6FF" BorderThickness="2"
					FontWeight="Bold" FontSize="20" TabIndex="2" Click="ChangeButton_Click"/>			
		</StackPanel>
	</Grid>
</Window>
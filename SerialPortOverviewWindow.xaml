<Window x:Class="DroneSimulator.SerialPortOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="串口概览" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#181F2A">

    <Border Background="#232F3E" CornerRadius="12" Padding="20" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="串口配置概览" Foreground="#5EC6FF" 
                       FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <DataGrid Grid.Row="1" x:Name="ConfigDataGrid" 
                      ItemsSource="{Binding Configs}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="#232F3E"
                      Foreground="#5EC6FF"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#5EC6FF"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="端口" Binding="{Binding PortName}" Width="80"/>
                    <DataGridTextColumn Header="用途" Binding="{Binding PurposeDisplay}" Width="120"/>
                    <DataGridTextColumn Header="波特率" Binding="{Binding BaudRate}" Width="80"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="80"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="150"/>
                    <DataGridTextColumn Header="最后使用" Binding="{Binding LastUsedDisplay}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Row="2" Content="关闭" Margin="0,20,0,0" Padding="15,5" 
                    Background="#232F3E" Foreground="#5EC6FF" BorderBrush="#5EC6FF"
                    Click="Close_Click" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
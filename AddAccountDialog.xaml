<Window x:Class="DroneSimulator.AddAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加账户" Height="290" Width="372"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#181F2A"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- 科技感文本框 -->
        <Style x:Key="TechTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="18">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TechPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="18">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30,30,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="账户类型：" FontSize="18" Width="90" VerticalAlignment="Center" Foreground="#5EC6FF"/>
            <ComboBox x:Name="TypeComboBox" Width="200" FontSize="18" HorizontalContentAlignment="Center">
                <ComboBoxItem Content="学生" FontSize="18"/>
                <ComboBoxItem Content="老师" FontSize="18"/>
                <ComboBoxItem Content="管理员"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="姓名：" FontSize="18" Width="90" VerticalAlignment="Center" Foreground="#5EC6FF"/>
            <TextBox x:Name="NameTextBox" FontSize="18" Width="200" HorizontalContentAlignment="Center" Style="{StaticResource TechTextBox}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="身份证号：" FontSize="18" Width="90" VerticalAlignment="Center" Foreground="#5EC6FF"/>
            <TextBox x:Name="IdTextBox" FontSize="18" Width="200" HorizontalContentAlignment="Center" Style="{StaticResource TechTextBox}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="密码：" FontSize="18" Width="90" VerticalAlignment="Center" Foreground="#5EC6FF"/>
            <PasswordBox x:Name="PasswordBox" FontSize="18" Width="200" HorizontalContentAlignment="Center" Style="{StaticResource TechPasswordBox}"/>
        </StackPanel>
        <Button Grid.Row="4" Content="添加账户" Width="120" Height="36" Margin="130,2,0,2"
                Background="#232F3E" Foreground="#5EC6FF" BorderBrush="#5EC6FF" BorderThickness="2"
                FontWeight="Bold" FontSize="20" Click="AddButton_Click" HorizontalAlignment="Left"/>
    </Grid>
</Window>
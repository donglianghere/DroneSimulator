<Window x:Class="DroneSimulator.FCImportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="飞控题库导入进度" Height="530" Width="700"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">
    
    <Window.Resources>
        <!-- 按钮样式 -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 取消按钮样式 -->
        <Style TargetType="Button" x:Key="CancelButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B71C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,20,20,7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="飞控实操题库导入"
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#2196F3"
                   Margin="0,0,0,20"/>

        <!-- 文件信息 -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="文件信息" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="文件路径：" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FilePathText" 
                               TextWrapping="Wrap" Foreground="#666"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="文件大小：" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FileSizeText" 
                               Margin="0,5,0,0" Foreground="#666"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="导入选项：" FontWeight="Bold" Margin="0,5,0,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,5,0,0">
                        <CheckBox x:Name="OverwriteExistingCheckBox" 
                                  Content="覆盖现有题目" 
                                  IsChecked="False"
                                  Margin="0,0,20,0"/>
                        <CheckBox x:Name="SkipInvalidRowsCheckBox" 
                                  Content="跳过无效行" 
                                  IsChecked="True"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 进度信息 -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="导入进度" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                
                <!-- 总进度 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="OverallProgressBar" 
                                 Height="25" 
                                 Background="#F0F0F0"
                                 Foreground="#2196F3"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"/>
                    <TextBlock x:Name="OverallProgressText" 
                               Grid.Column="1" 
                               Text="0%"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"/>
                </Grid>

                <!-- 当前状态 -->
                <TextBlock x:Name="CurrentStatusText" 
                           Text="准备导入..."
                           FontSize="14"
                           Foreground="#666"
                           Margin="0,0,0,10"/>

                <!-- 统计信息 -->
                <UniformGrid Columns="4" Margin="0,5,0,0">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="总行数" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalRowsText" Text="0" FontSize="18" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Foreground="#2196F3"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="成功导入" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SuccessCountText" Text="0" FontSize="18" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Foreground="#4CAF50"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="跳过/覆盖" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SkipOverwriteCountText" Text="0" FontSize="18" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Foreground="#FF9800"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="失败" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FailCountText" Text="0" FontSize="18" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Foreground="#F44336"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- 详细日志 -->
        <Border Grid.Row="3" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="6"
                Padding="10">
            <Grid Margin="0,0,0,-7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="导入日志" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox x:Name="AutoScrollCheckBox" 
                              Content="自动滚动" 
                              IsChecked="True" 
                              Margin="20,0,0,0"/>
                    <Button x:Name="ClearLogButton" 
                            Content="清空日志" 
                            Style="{StaticResource ModernButton}"
                            Background="#9E9E9E"
                            Padding="8,4"
                            FontSize="12"
                            Margin="10,0,0,0"
                            Click="ClearLog_Click"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" 
                              x:Name="LogScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="#FAFAFA">
                    <TextBlock x:Name="LogTextBlock" 
                               FontFamily="Consolas" 
                               FontSize="12"
                               Padding="10"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">
            <Button x:Name="StartImportButton" 
                    Content="开始导入" 
                    Style="{StaticResource ModernButton}"
                    Click="StartImport_Click"/>
            <Button x:Name="CancelButton" 
                    Content="取消导入" 
                    Style="{StaticResource CancelButton}"
                    Click="Cancel_Click"/>
            <Button x:Name="CloseButton" 
                    Content="关闭窗口" 
                    Style="{StaticResource ModernButton}"
                    Background="#4CAF50"
                    Click="Close_Click"
                    IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
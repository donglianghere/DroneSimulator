<Window x:Class="DroneSimulator.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DroneSimulator"
        Title="康鹤多旋翼无人机检修平台-V1.0" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowState="Maximized"
        ShowInTaskbar="True"
        Icon="/Resources/drone-icon.png"
        WindowStyle="SingleBorderWindow">

    <Window.Background>
        <!-- 深邃太空背景色或深色图片 -->
        <SolidColorBrush Color="#181F2A"/>
        <!-- 或者用深色太空图片，建议图片本身偏暗 -->
        <!-- <ImageBrush ImageSource="/Resources/aerospace-bg.jpg" Stretch="UniformToFill" Opacity="0.7"/>  -->
    </Window.Background>

    <Window.Resources>
        <local:ErrorToBrushConverter x:Key="ErrorToBrushConverter"/>
        <!-- 科技感按钮 -->
        <Style x:Key="TechButton" TargetType="Button">
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="8,4"/>            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#5EC6FF" BlurRadius="8" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A4A6A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFD700"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFD700" BlurRadius="12" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource TechButton}">
            <Setter Property="Background" Value="#B22222"/>
            <Setter Property="BorderBrush" Value="#B22222"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#B22222" BlurRadius="8" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A1A1A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 科技感文本框 -->
        <Style x:Key="TechTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 科技感密码框 -->
        <Style x:Key="TechPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 科技感ComboBox -->
        <Style x:Key="TechComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="Foreground" Value="#5EC6FF"/>
            <Setter Property="BorderBrush" Value="#5EC6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <!-- 下拉项样式：高亮蓝字，深色底 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FF08081F"/>
            <Setter Property="Background" Value="#232F3E"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#223B5A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A4A6A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 背景Logo - 放在最底层 -->
        <Image Source="/Resources/logo.png" 
               Grid.Row="0" 
               Grid.RowSpan="2"
               HorizontalAlignment="Left" 
               VerticalAlignment="Top"
               Width="150" 
               Height="150"
               Margin="20,20,0,0"
               Opacity="0.85"
               Panel.ZIndex="-1"/>  

        <!-- 顶部平台标题 -->
        <TextBlock Grid.Row="0"
           Text="康鹤多旋翼无人机检修平台-V1.0"
           FontFamily="微软雅黑"
           FontSize="60"
           FontWeight="Bold"
           HorizontalAlignment="Center"
           Margin="0,100,0,20">
            <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5EC6FF" Offset="0"/>
                    <GradientStop Color="#7F3FFF" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
            <TextBlock.Effect>
                <DropShadowEffect Color="#5EC6FF" BlurRadius="16" ShadowDepth="2" Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>

        <Grid Grid.Row="1"
              Margin="40"
              VerticalAlignment="Top"
              HorizontalAlignment="Center">
            <Border Background="#232F3E"
                    CornerRadius="20"
                    Padding="20"
                    Opacity="0.98"
                    Effect="{x:Null}" HorizontalAlignment="Center" Width="420">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="注册/登录"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#5EC6FF"
                               HorizontalAlignment="Left"
                               Margin="190,-4,0,24"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,10"
                                Width="350"
                                HorizontalAlignment="Center">
                        <TextBlock Text="用户类型:"
                                   Height="36"
                                   Width="100"
                                   VerticalAlignment="Center"
                                   FontFamily="微软雅黑"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#5EC6FF"/>
                        <ComboBox x:Name="UserTypeCombo"
                                  Height="36"
                                  Width="250"
                                  FontSize="20"
                                  Style="{StaticResource TechComboBox}"
                                  HorizontalContentAlignment="Center"
                                  TabIndex="0">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="老师" IsSelected="True"/>
                            <ComboBoxItem Content="学生"/>
                            <ComboBoxItem Content="管理员"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,0,0,10"
                                Width="350"
                                HorizontalAlignment="Center">
                        <TextBlock Text="姓       名:"
                                   Height="36"
                                   Width="100"
                                   FontFamily="微软雅黑"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#5EC6FF"/>
                        <TextBox x:Name="NameBox"
                                 Height="36"
                                 Width="250"
                                 FontSize="20"
                                 Style="{StaticResource TechTextBox}"
                                 TextChanged="NameBox_TextChanged"
                                 ToolTip="{Binding ElementName=NameBox, Path=Tag, Mode=OneWay}"
                                 BorderBrush="{Binding ElementName=NameBox, Path=Tag, Converter={StaticResource ErrorToBrushConverter}}"
                                 TabIndex="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Margin="0,0,0,10"
                                Width="350"
                                HorizontalAlignment="Center">
                        <TextBlock Text="身份证号:"
                                   Height="36"
                                   Width="100"
                                   VerticalAlignment="Center"
                                   FontFamily="微软雅黑"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#5EC6FF"/>
                        <TextBox x:Name="IdBox"
                                 Height="36"
                                 Width="250"
                                 FontSize="20"
                                 TabIndex="2"
                                 Style="{StaticResource TechTextBox}"
                                 TextChanged="IdBox_TextChanged"
                                 ToolTip="{Binding ElementName=IdBox, Path=Tag, Mode=OneWay}"
                                 BorderBrush="{Binding ElementName=IdBox, Path=Tag, Converter={StaticResource ErrorToBrushConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                Margin="0,0,0,10"
                                Width="350"
                                HorizontalAlignment="Center">
                        <TextBlock Text="密       码:"
                                   Height="36"
                                   Width="100"
                                   FontFamily="微软雅黑"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#5EC6FF"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Height="36"
                                     Width="250"
                                     FontSize="20"
                                     TabIndex="3"
                                     Style="{StaticResource TechPasswordBox}"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     ToolTip="{Binding ElementName=PasswordBox, Path=Tag, Mode=OneWay}"
                                     BorderBrush="{Binding ElementName=PasswordBox, Path=Tag, Converter={StaticResource ErrorToBrushConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,10,0,0"
                            Width="350"
                            Height="36" >
                        <Button Content="退  出"
                            Width="100"
                            Height="36"
                            FontFamily="微软雅黑"
                            FontSize="22"
                            FontWeight="Bold"
                            Margin="0,0,25,0"
                            TabIndex="4"
                            Style="{StaticResource ExitButtonStyle}"
                            Click="ExitButton_Click"/>
                        <Button Content="注  册"
                            x:Name="RegisterButton"
                            Width="100"
                            Height="36"
                            FontFamily="微软雅黑"
                            FontSize="22"
                            FontWeight="Bold"
                            Margin="0,0,25,0"
                            TabIndex="5"
                            Style="{StaticResource TechButton}"
                            Click="RegisterButton_Click"/>
                        <Button Content="登  录"
                            Width="100"
                            Height="36"
                            FontFamily="微软雅黑"
                            FontSize="22"
                            FontWeight="Bold"
                            Style="{StaticResource TechButton}"
                            TabIndex="6"
                            Click="LoginButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
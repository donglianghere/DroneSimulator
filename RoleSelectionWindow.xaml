<Window x:Class="DroneSimulator.RoleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择登录身份" Height="350" Width="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
	<Grid Background="#FF667EEA" Margin="0,0,0,0">
		<Border Background="White" 
                CornerRadius="10" 
                Margin="10" 
                Padding="10">
			<StackPanel>
				<TextBlock Text="选择登录身份" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"
                           Foreground="#2D3A4A"/>

				<TextBlock x:Name="UserInfoText"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           Foreground="#666"/>

				<StackPanel x:Name="RoleButtonPanel">
					<!-- 动态添加按钮 -->
				</StackPanel>

				<Button Name="CancelButton"
                        Content="取         消"
                        Width="202"
                        Height="40"
                        Margin="0,10,0,0"
                        Background="#FF1B6B"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="Bold"
                        Click="CancelButton_Click"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>
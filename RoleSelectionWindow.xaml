<Window x:Class="DroneSimulator.RoleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择登录身份" Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Background="#FF667EEA">
        <Border Background="White" 
                CornerRadius="10" 
                Margin="20" 
                Padding="20">
            <StackPanel>
                <TextBlock Text="选择登录身份" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"
                           Foreground="#2D3A4A"/>

                <TextBlock x:Name="UserInfoText"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Foreground="#666"/>

                <StackPanel x:Name="RoleButtonPanel">
                    <!-- 动态添加按钮 -->
                </StackPanel>

                <Button Name="CancelButton"
                        Content="取 消"
                        Width="100"
                        Height="35"
                        Margin="0,20,0,0"
                        Background="#FF6B6B"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>